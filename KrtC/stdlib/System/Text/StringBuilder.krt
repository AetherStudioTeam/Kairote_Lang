namespace System.Text

public class StringBuilder
{
    private var chunks: char[][]
    private var chunkCount: int32
    private var currentChunk: int32
    private var currentIndex: int32
    private var chunkSize: int32
    private var totalLength: int32

    public function StringBuilder()
    {
        this.StringBuilder(16)
    }

    public function StringBuilder(capacity: int32)
    {
        this.StringBuilder("", capacity)
    }

    public function StringBuilder(value: string)
    {
        this.StringBuilder(value, 16)
    }

    public function StringBuilder(value: string, capacity: int32)
    {
        this.StringBuilder(value, 0, value.Length(), capacity)
    }

    public function StringBuilder(value: string, startIndex: int32, length: int32, capacity: int32)
    {
        if capacity < 0
        {
            throw new ArgumentOutOfRangeException("capacity")
        }
        if startIndex < 0 || length < 0 || startIndex + length > value.Length()
        {
            throw new ArgumentOutOfRangeException("startIndex or length")
        }
        this.chunkSize = capacity > 16 ? capacity : 16
        this.chunks = new char[][4]
        this.chunks[0] = new char[this.chunkSize]
        this.chunkCount = 1
        this.currentChunk = 0
        this.currentIndex = 0
        this.totalLength = 0
        if length > 0
        {
            for var i = 0; i < length; i = i + 1
            {
                this.Append(value.get_Chars(startIndex + i))
            }
        }
    }

    public function get_Capacity(): int32
    {
        return this.chunkSize * this.chunks.Length
    }

    public function set_Capacity(value: int32)
    {
        if value < this.totalLength
        {
            throw new ArgumentOutOfRangeException("value")
        }
        var newChunkCount = (value + this.chunkSize - 1) / this.chunkSize
        if newChunkCount > this.chunks.Length
        {
            var newChunks = new char[][newChunkCount]
            for var i = 0; i < this.chunkCount; i = i + 1
            {
                newChunks[i] = this.chunks[i]
            }
            this.chunks = newChunks
        }
    }

    public function get_Length(): int32
    {
        return this.totalLength
    }

    public function set_Length(value: int32)
    {
        if value < 0
        {
            throw new ArgumentOutOfRangeException("value")
        }
        if value < this.totalLength
        {
            var newChunk = value / this.chunkSize
            var newIndex = value % this.chunkSize
            this.currentChunk = newChunk
            this.currentIndex = newIndex
            this.totalLength = value
            for var i = newChunk + 1; i < this.chunkCount; i = i + 1
            {
                this.chunks[i] = null
            }
            this.chunkCount = newChunk + 1
        }
        else if value > this.totalLength
        {
            for var i = this.totalLength; i < value; i = i + 1
            {
                this.Append('\0')
            }
        }
    }

    public function get_Chars(index: int32): char
    {
        if index < 0 || index >= this.totalLength
        {
            throw new ArgumentOutOfRangeException("index")
        }
        var chunk = index / this.chunkSize
        var idx = index % this.chunkSize
        return this.chunks[chunk][idx]
    }

    public function set_Chars(index: int32, value: char)
    {
        if index < 0 || index >= this.totalLength
        {
            throw new ArgumentOutOfRangeException("index")
        }
        var chunk = index / this.chunkSize
        var idx = index % this.chunkSize
        this.chunks[chunk][idx] = value
    }

    public function Append(value: char): StringBuilder
    {
        this.EnsureSpace(1)
        this.chunks[this.currentChunk][this.currentIndex] = value
        this.currentIndex = this.currentIndex + 1
        if this.currentIndex >= this.chunkSize
        {
            this.currentChunk = this.currentChunk + 1
            this.currentIndex = 0
        }
        this.totalLength = this.totalLength + 1
        return this
    }

    public function Append(value: char[], startIndex: int32, charCount: int32): StringBuilder
    {
        if value == null
        {
            return this
        }
        if startIndex < 0 || charCount < 0 || startIndex + charCount > value.Length)
        {
            throw new ArgumentOutOfRangeException("startIndex or charCount")
        }
        for var i = 0; i < charCount; i = i + 1
        {
            this.Append(value[startIndex + i])
        }
        return this
    }

    public function Append(value: string): StringBuilder
    {
        if value == null)
        {
            return this
        }
        for var i = 0; i < value.Length(); i = i + 1)
        {
            this.Append(value.get_Chars(i))
        }
        return this
    }

    public function Append(value: string, startIndex: int32, count: int32): StringBuilder
    {
        if value == null)
        {
            return this
        }
        if startIndex < 0 || count < 0 || startIndex + count > value.Length())
        {
            throw new ArgumentOutOfRangeException("startIndex or count")
        }
        for var i = 0; i < count; i = i + 1)
        {
            this.Append(value.get_Chars(startIndex + i))
        }
        return this
    }

    public function Append(value: bool): StringBuilder
    {
        return this.Append(value.ToString())
    }

    public function Append(value: int32): StringBuilder
    {
        return this.Append(value.ToString())
    }

    public function Append(value: int64): StringBuilder
    {
        return this.Append(value.ToString())
    }

    public function Append(value: float32): StringBuilder
    {
        return this.Append(value.ToString())
    }

    public function Append(value: float64): StringBuilder
    {
        return this.Append(value.ToString())
    }

    public function Append(value: Object): StringBuilder
    {
        if value == null)
        {
            return this
        }
        return this.Append(value.ToString())
    }

    public function AppendLine(): StringBuilder
    {
        return this.Append('\r').Append('\n')
    }

    public function AppendLine(value: string): StringBuilder
    {
        this.Append(value)
        return this.AppendLine()
    }

    public function AppendFormat(format: string, arg0: Object): StringBuilder
    {
        return this.Append(String.Format(format, arg0))
    }

    public function AppendFormat(format: string, arg0: Object, arg1: Object): StringBuilder
    {
        return this.Append(String.Format(format, arg0, arg1))
    }

    public function AppendFormat(format: string, arg0: Object, arg1: Object, arg2: Object): StringBuilder
    {
        return this.Append(String.Format(format, arg0, arg1, arg2))
    }

    public function Clear(): StringBuilder
    {
        this.currentChunk = 0
        this.currentIndex = 0
        this.totalLength = 0
        return this
    }

    public function Insert(index: int32, value: string): StringBuilder
    {
        if index < 0 || index > this.totalLength)
        {
            throw new ArgumentOutOfRangeException("index")
        }
        if value == null || value.Length() == 0)
        {
            return this
        }
        var newLength = this.totalLength + value.Length()
        this.EnsureSpace(value.Length())
        for var i = this.totalLength - 1; i >= index; i = i - 1)
        {
            this.SetCharAt(i + value.Length(), this.GetCharAt(i))
        }
        for var i = 0; i < value.Length(); i = i + 1)
        {
            this.SetCharAt(index + i, value.get_Chars(i))
        }
        this.totalLength = newLength
        return this
    }

    public function Remove(startIndex: int32, length: int32): StringBuilder
    {
        if startIndex < 0 || length < 0 || startIndex + length > this.totalLength)
        {
            throw new ArgumentOutOfRangeException("startIndex or length")
        }
        for var i = startIndex + length; i < this.totalLength; i = i + 1)
        {
            this.SetCharAt(i - length, this.GetCharAt(i))
        }
        this.totalLength = this.totalLength - length
        return this
    }

    public function Replace(oldChar: char, newChar: char): StringBuilder
    {
        for var i = 0; i < this.totalLength; i = i + 1)
        {
            if this.GetCharAt(i) == oldChar)
            {
                this.SetCharAt(i, newChar)
            }
        }
        return this
    }

    public function Replace(oldValue: string, newValue: string): StringBuilder
    {
        if oldValue == null || oldValue.Length() == 0)
        {
            throw new ArgumentException("oldValue")
        }
        var i = 0
        while i <= this.totalLength - oldValue.Length())
        {
            var found = true
            for var j = 0; j < oldValue.Length(); j = j + 1)
            {
                if this.GetCharAt(i + j) != oldValue.get_Chars(j))
                {
                    found = false
                    break
                }
            }
            if found)
            {
                var before = this.ToString().Substring(0, i)
                var after = this.ToString().Substring(i + oldValue.Length())
                this.Clear()
                this.Append(before)
                this.Append(newValue)
                this.Append(after)
                i = i + newValue.Length()
            }
            else
            {
                i = i + 1
            }
        }
        return this
    }

    public function ToString(): string
    {
        var chars = new char[this.totalLength]
        var pos = 0
        for var i = 0; i < this.chunkCount; i = i + 1)
        {
            var chunkLen = this.chunkSize
            if i == this.currentChunk)
            {
                chunkLen = this.currentIndex
            }
            if i == this.chunkCount - 1 && this.currentChunk == i)
            {
                chunkLen = this.currentIndex
            }
            for var j = 0; j < chunkLen && pos < this.totalLength; j = j + 1)
            {
                chars[pos] = this.chunks[i][j]
                pos = pos + 1
            }
        }
        return new String(chars)
    }

    public function ToString(startIndex: int32, length: int32): string
    {
        if startIndex < 0 || length < 0 || startIndex + length > this.totalLength)
        {
            throw new ArgumentOutOfRangeException("startIndex or length")
        }
        var chars = new char[length]
        for var i = 0; i < length; i = i + 1)
        {
            chars[i] = this.GetCharAt(startIndex + i)
        }
        return new String(chars)
    }

    private function EnsureSpace(needed: int32)
    {
        var available = this.chunkSize - this.currentIndex
        if this.currentChunk < this.chunkCount - 1)
        {
            available = this.chunkSize
        }
        if available < needed)
        {
            this.currentChunk = this.currentChunk + 1
            this.currentIndex = 0
            if this.currentChunk >= this.chunks.Length)
            {
                var newChunks = new char[][this.chunks.Length * 2]
                for var i = 0; i < this.chunks.Length; i = i + 1)
                {
                    newChunks[i] = this.chunks[i]
                }
                this.chunks = newChunks
            }
            if this.chunks[this.currentChunk] == null)
            {
                this.chunks[this.currentChunk] = new char[this.chunkSize]
            }
            this.chunkCount = this.chunkCount + 1
        }
    }

    private function GetCharAt(index: int32): char
    {
        var chunk = index / this.chunkSize
        var idx = index % this.chunkSize
        return this.chunks[chunk][idx]
    }

    private function SetCharAt(index: int32, value: char)
    {
        var chunk = index / this.chunkSize
        var idx = index % this.chunkSize
        this.chunks[chunk][idx] = value
    }
}
