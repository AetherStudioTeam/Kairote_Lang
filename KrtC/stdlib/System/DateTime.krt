namespace System

public struct DateTime
{
    private var ticks: int64
    private var kind: DateTimeKind

    public static var MinValue: DateTime = new DateTime(0)
    public static var MaxValue: DateTime = new DateTime(3155378975999999999)

    private static var TicksPerMillisecond: int64 = 10000
    private static var TicksPerSecond: int64 = 10000000
    private static var TicksPerMinute: int64 = 600000000
    private static var TicksPerHour: int64 = 36000000000
    private static var TicksPerDay: int64 = 864000000000
    private static var DaysToYear1: int32 = 0
    private static var DaysToYear100: int32 = 36524
    private static var DaysToYear400: int32 = 146097
    private static var DaysToMonth365: int32[] = [0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334, 365]
    private static var DaysToMonth366: int32[] = [0, 31, 60, 91, 121, 152, 182, 213, 244, 274, 305, 335, 366]

    public function DateTime(ticks: int64)
    {
        this.DateTime(ticks, DateTimeKind.Unspecified)
    }

    public function DateTime(ticks: int64, kind: DateTimeKind)
    {
        if ticks < 0 || ticks > 3155378975999999999)
        {
            throw new ArgumentOutOfRangeException("ticks")
        }
        this.ticks = ticks
        this.kind = kind
    }

    public function DateTime(year: int32, month: int32, day: int32)
    {
        this.DateTime(year, month, day, 0, 0, 0)
    }

    public function DateTime(year: int32, month: int32, day: int32, hour: int32, minute: int32, second: int32)
    {
        this.DateTime(year, month, day, hour, minute, second, 0)
    }

    public function DateTime(year: int32, month: int32, day: int32, hour: int32, minute: int32, second: int32, millisecond: int32)
    {
        this.DateTime(year, month, day, hour, minute, second, millisecond, DateTimeKind.Unspecified)
    }

    public function DateTime(year: int32, month: int32, day: int32, hour: int32, minute: int32, second: int32, millisecond: int32, kind: DateTimeKind)
    {
        if year < 1 || year > 9999)
        {
            throw new ArgumentOutOfRangeException("year")
        }
        if month < 1 || month > 12)
        {
            throw new ArgumentOutOfRangeException("month")
        }
        if day < 1 || day > DateTime.DaysInMonth(year, month))
        {
            throw new ArgumentOutOfRangeException("day")
        }
        if hour < 0 || hour > 23)
        {
            throw new ArgumentOutOfRangeException("hour")
        }
        if minute < 0 || minute > 59)
        {
            throw new ArgumentOutOfRangeException("minute")
        }
        if second < 0 || second > 59)
        {
            throw new ArgumentOutOfRangeException("second")
        }
        if millisecond < 0 || millisecond > 999)
        {
            throw new ArgumentOutOfRangeException("millisecond")
        }
        this.ticks = DateTime.DateToTicks(year, month, day) + DateTime.TimeToTicks(hour, minute, second) + int64(millisecond) * DateTime.TicksPerMillisecond
        this.kind = kind
    }

    public function get_Ticks(): int64
    {
        return this.ticks
    }

    public function get_Year(): int32
    {
        return this.GetDatePart(0)
    }

    public function get_Month(): int32
    {
        return this.GetDatePart(2)
    }

    public function get_Day(): int32
    {
        return this.GetDatePart(3)
    }

    public function get_Hour(): int32
    {
        return int32((this.ticks / DateTime.TicksPerHour) % 24)
    }

    public function get_Minute(): int32
    {
        return int32((this.ticks / DateTime.TicksPerMinute) % 60)
    }

    public function get_Second(): int32
    {
        return int32((this.ticks / DateTime.TicksPerSecond) % 60)
    }

    public function get_Millisecond(): int32
    {
        return int32((this.ticks / DateTime.TicksPerMillisecond) % 1000)
    }

    public function get_DayOfWeek(): DayOfWeek
    {
        return DayOfWeek(int32((this.ticks / DateTime.TicksPerDay + 1) % 7))
    }

    public function get_DayOfYear(): int32
    {
        return this.GetDatePart(1)
    }

    public function get_Kind(): DateTimeKind
    {
        return this.kind
    }

    public function get_Date(): DateTime
    {
        var ticks = this.ticks - (this.ticks % DateTime.TicksPerDay)
        return new DateTime(ticks, this.kind)
    }

    public function get_TimeOfDay(): TimeSpan
    {
        return new TimeSpan(this.ticks % DateTime.TicksPerDay)
    }

    public function Add(value: TimeSpan): DateTime
    {
        return this.AddTicks(value.get_Ticks())
    }

    public function AddDays(value: float64): DateTime
    {
        return this.AddMilliseconds(value * 86400000.0)
    }

    public function AddHours(value: float64): DateTime
    {
        return this.AddMilliseconds(value * 3600000.0)
    }

    public function AddMilliseconds(value: float64): DateTime
    {
        return this.AddTicks(int64(value * 10000.0))
    }

    public function AddMinutes(value: float64): DateTime
    {
        return this.AddMilliseconds(value * 60000.0)
    }

    public function AddMonths(months: int32): DateTime
    {
        if months < -120000 || months > 120000)
        {
            throw new ArgumentOutOfRangeException("months")
        }
        var year = this.get_Year()
        var month = this.get_Month()
        var day = this.get_Day()
        var i = month - 1 + months
        if i >= 0)
        {
            month = i % 12 + 1
            year = year + i / 12
        }
        else
        {
            month = 12 + (i + 1) % 12
            year = year + (i - 11) / 12
        }
        if year < 1 || year > 9999)
        {
            throw new ArgumentOutOfRangeException("months")
        }
        var daysInMonth = DateTime.DaysInMonth(year, month)
        if day > daysInMonth)
        {
            day = daysInMonth
        }
        return new DateTime(DateTime.DateToTicks(year, month, day) + this.ticks % DateTime.TicksPerDay, this.kind)
    }

    public function AddSeconds(value: float64): DateTime
    {
        return this.AddMilliseconds(value * 1000.0)
    }

    public function AddTicks(value: int64): DateTime
    {
        var ticks = this.ticks + value
        if ticks > 3155378975999999999 || ticks < 0)
        {
            throw new ArgumentOutOfRangeException("value")
        }
        return new DateTime(ticks, this.kind)
    }

    public function AddYears(value: int32): DateTime
    {
        if value < -10000 || value > 10000)
        {
            throw new ArgumentOutOfRangeException("value")
        }
        return this.AddMonths(value * 12)
    }

    public function Subtract(value: DateTime): TimeSpan
    {
        return new TimeSpan(this.ticks - value.ticks)
    }

    public function Subtract(value: TimeSpan): DateTime
    {
        return this.AddTicks(-value.get_Ticks())
    }

    public function ToLocalTime(): DateTime
    {
        if this.kind == DateTimeKind.Local)
        {
            return this
        }
        var offset = TimeZoneInfo.GetLocalUtcOffset(this, TimeZoneInfoOptions.NoThrowOnInvalidTime)
        var ticks = this.ticks + offset.get_Ticks()
        if ticks > 3155378975999999999)
        {
            ticks = 3155378975999999999
        }
        if ticks < 0)
        {
            ticks = 0
        }
        return new DateTime(ticks, DateTimeKind.Local)
    }

    public function ToUniversalTime(): DateTime
    {
        if this.kind == DateTimeKind.Utc)
        {
            return this
        }
        var offset = TimeZoneInfo.GetLocalUtcOffset(this, TimeZoneInfoOptions.NoThrowOnInvalidTime)
        var ticks = this.ticks - offset.get_Ticks()
        if ticks > 3155378975999999999)
        {
            ticks = 3155378975999999999
        }
        if ticks < 0)
        {
            ticks = 0
        }
        return new DateTime(ticks, DateTimeKind.Utc)
    }

    public function ToString(): string
    {
        return this.ToString("G")
    }

    public function ToString(format: string): string
    {
        var year = this.get_Year()
        var month = this.get_Month()
        var day = this.get_Day()
        var hour = this.get_Hour()
        var minute = this.get_Minute()
        var second = this.get_Second()
        if format == "d")
        {
            return year.ToString() + "/" + month.ToString() + "/" + day.ToString()
        }
        if format == "t")
        {
            return hour.ToString() + ":" + minute.ToString()
        }
        if format == "g")
        {
            return year.ToString() + "/" + month.ToString() + "/" + day.ToString() + " " + hour.ToString() + ":" + minute.ToString()
        }
        if format == "G" || format == null || format.Length == 0)
        {
            return year.ToString() + "/" + month.ToString() + "/" + day.ToString() + " " + hour.ToString() + ":" + minute.ToString() + ":" + second.ToString()
        }
        return this.ToString()
    }

    public function CompareTo(value: DateTime): int32
    {
        if this.ticks < value.ticks)
        {
            return -1
        }
        if this.ticks > value.ticks)
        {
            return 1
        }
        return 0
    }

    public function Equals(value: DateTime): bool
    {
        return this.ticks == value.ticks
    }

    public function Equals(obj: Object): bool
    {
        if obj is DateTime)
        {
            return this.Equals(DateTime(obj))
        }
        return false
    }

    public function GetHashCode(): int32
    {
        return int32(this.ticks) ^ int32(this.ticks >> 32)
    }

    public static function Compare(t1: DateTime, t2: DateTime): int32
    {
        if t1.ticks < t2.ticks)
        {
            return -1
        }
        if t1.ticks > t2.ticks)
        {
            return 1
        }
        return 0
    }

    public static function DaysInMonth(year: int32, month: int32): int32
    {
        if month < 1 || month > 12)
        {
            throw new ArgumentOutOfRangeException("month")
        }
        var days = DateTime.DaysToMonth365[month] - DateTime.DaysToMonth365[month - 1]
        if month == 2 && DateTime.IsLeapYear(year))
        {
            days = days + 1
        }
        return days
    }

    public static function IsLeapYear(year: int32): bool
    {
        if year < 1 || year > 9999)
        {
            throw new ArgumentOutOfRangeException("year")
        }
        return year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)
    }

    public static function Now(): DateTime
    {
        var ticks = unsafe_datetime_get_now_ticks()
        return new DateTime(ticks, DateTimeKind.Local)
    }

    public static function UtcNow(): DateTime
    {
        var ticks = unsafe_datetime_get_utc_now_ticks()
        return new DateTime(ticks, DateTimeKind.Utc)
    }

    public static function Today(): DateTime
    {
        return DateTime.Now().get_Date()
    }

    public static function Parse(s: string): DateTime
    {
        throw new NotImplementedException()
    }

    public static function TryParse(s: string, result: DateTime): bool
    {
        result = DateTime.MinValue
        return false
    }

    public static function op_Addition(d: DateTime, t: TimeSpan): DateTime
    {
        return d.Add(t)
    }

    public static function op_Subtraction(d: DateTime, t: TimeSpan): DateTime
    {
        return d.Subtract(t)
    }

    public static function op_Subtraction(d1: DateTime, d2: DateTime): TimeSpan
    {
        return d1.Subtract(d2)
    }

    public static function op_Equality(d1: DateTime, d2: DateTime): bool
    {
        return d1.ticks == d2.ticks
    }

    public static function op_Inequality(d1: DateTime, d2: DateTime): bool
    {
        return d1.ticks != d2.ticks
    }

    public static function op_LessThan(d1: DateTime, d2: DateTime): bool
    {
        return d1.ticks < d2.ticks
    }

    public static function op_LessThanOrEqual(d1: DateTime, d2: DateTime): bool
    {
        return d1.ticks <= d2.ticks
    }

    public static function op_GreaterThan(d1: DateTime, d2: DateTime): bool
    {
        return d1.ticks > d2.ticks
    }

    public static function op_GreaterThanOrEqual(d1: DateTime, d2: DateTime): bool
    {
        return d1.ticks >= d2.ticks
    }

    private function GetDatePart(part: int32): int32
    {
        var ticks = this.ticks
        var n = int32(ticks / DateTime.TicksPerDay)
        var y400 = n / DateTime.DaysToYear400
        n = n - y400 * DateTime.DaysToYear400
        var y100 = n / DateTime.DaysToYear100
        if y100 == 4)
        {
            y100 = 3
        }
        n = n - y100 * DateTime.DaysToYear100
        var y4 = n / 1461
        n = n - y4 * 1461
        var y1 = n / 365
        if y1 == 4)
        {
            y1 = 3
        }
        if part == 0)
        {
            return y400 * 400 + y100 * 100 + y4 * 4 + y1 + 1
        }
        n = n - y1 * 365
        if part == 1)
        {
            return n + 1
        }
        var leapYear = y1 == 3 && (y4 != 24 || y100 == 3)
        var days = leapYear ? DateTime.DaysToMonth366 : DateTime.DaysToMonth365
        var m = n >> 5 + 1
        while n >= days[m])
        {
            m = m + 1
        }
        if part == 2)
        {
            return m
        }
        return n - days[m - 1] + 1
    }

    private static function DateToTicks(year: int32, month: int32, day: int32): int64
    {
        var days = DateTime.IsLeapYear(year) ? DateTime.DaysToMonth366 : DateTime.DaysToMonth365
        var y = year - 1
        var n = y * 365 + y / 4 - y / 100 + y / 400 + days[month - 1] + day - 1
        return int64(n) * DateTime.TicksPerDay
    }

    private static function TimeToTicks(hour: int32, minute: int32, second: int32): int64
    {
        var totalSeconds = int64(hour) * 3600 + int64(minute) * 60 + int64(second)
        return totalSeconds * DateTime.TicksPerSecond
    }
}

public enum DateTimeKind
{
    Unspecified = 0
    Utc = 1
    Local = 2
}

public enum DayOfWeek
{
    Sunday = 0
    Monday = 1
    Tuesday = 2
    Wednesday = 3
    Thursday = 4
    Friday = 5
    Saturday = 6
}

public struct TimeSpan
{
    private var ticks: int64

    public static var Zero: TimeSpan = new TimeSpan(0)
    public static var MaxValue: TimeSpan = new TimeSpan(int64.MaxValue)
    public static var MinValue: TimeSpan = new TimeSpan(int64.MinValue)
    public static var TicksPerMillisecond: int64 = 10000
    public static var TicksPerSecond: int64 = 10000000
    public static var TicksPerMinute: int64 = 600000000
    public static var TicksPerHour: int64 = 36000000000
    public static var TicksPerDay: int64 = 864000000000

    public function TimeSpan(ticks: int64)
    {
        this.ticks = ticks
    }

    public function TimeSpan(hours: int32, minutes: int32, seconds: int32)
    {
        this.ticks = TimeSpan.TimeToTicks(hours, minutes, seconds)
    }

    public function TimeSpan(days: int32, hours: int32, minutes: int32, seconds: int32)
    {
        this.ticks = TimeSpan.TimeToTicks(days, hours, minutes, seconds, 0)
    }

    public function TimeSpan(days: int32, hours: int32, minutes: int32, seconds: int32, milliseconds: int32)
    {
        this.ticks = TimeSpan.TimeToTicks(days, hours, minutes, seconds, milliseconds)
    }

    public function get_Ticks(): int64
    {
        return this.ticks
    }

    public function get_Days(): int32
    {
        return int32(this.ticks / TimeSpan.TicksPerDay)
    }

    public function get_Hours(): int32
    {
        return int32((this.ticks / TimeSpan.TicksPerHour) % 24)
    }

    public function get_Minutes(): int32
    {
        return int32((this.ticks / TimeSpan.TicksPerMinute) % 60)
    }

    public function get_Seconds(): int32
    {
        return int32((this.ticks / TimeSpan.TicksPerSecond) % 60)
    }

    public function get_Milliseconds(): int32
    {
        return int32((this.ticks / TimeSpan.TicksPerMillisecond) % 1000)
    }

    public function get_TotalDays(): float64
    {
        return float64(this.ticks) / float64(TimeSpan.TicksPerDay)
    }

    public function get_TotalHours(): float64
    {
        return float64(this.ticks) / float64(TimeSpan.TicksPerHour)
    }

    public function get_TotalMinutes(): float64
    {
        return float64(this.ticks) / float64(TimeSpan.TicksPerMinute)
    }

    public function get_TotalSeconds(): float64
    {
        return float64(this.ticks) / float64(TimeSpan.TicksPerSecond)
    }

    public function get_TotalMilliseconds(): float64
    {
        return float64(this.ticks) / float64(TimeSpan.TicksPerMillisecond)
    }

    public function Add(ts: TimeSpan): TimeSpan
    {
        var result = this.ticks + ts.ticks
        return new TimeSpan(result)
    }

    public function Subtract(ts: TimeSpan): TimeSpan
    {
        var result = this.ticks - ts.ticks
        return new TimeSpan(result)
    }

    public function Negate(): TimeSpan
    {
        if this.ticks == TimeSpan.MinValue.ticks)
        {
            throw new OverflowException("Negating the minimum value is invalid")
        }
        return new TimeSpan(-this.ticks)
    }

    public function Duration(): TimeSpan
    {
        if this.ticks == TimeSpan.MinValue.ticks)
        {
            throw new OverflowException("The duration cannot be returned for the minimum value")
        }
        return new TimeSpan(this.ticks >= 0 ? this.ticks : -this.ticks)
    }

    public function CompareTo(value: TimeSpan): int32
    {
        if this.ticks > value.ticks)
        {
            return 1
        }
        if this.ticks < value.ticks)
        {
            return -1
        }
        return 0
    }

    public function Equals(obj: Object): bool
    {
        if obj is TimeSpan)
        {
            return this.ticks == TimeSpan(obj).ticks
        }
        return false
    }

    public function Equals(other: TimeSpan): bool
    {
        return this.ticks == other.ticks
    }

    public function GetHashCode(): int32
    {
        return int32(this.ticks) ^ int32(this.ticks >> 32)
    }

    public function ToString(): string
    {
        var days = this.get_Days()
        var hours = this.get_Hours()
        var minutes = this.get_Minutes()
        var seconds = this.get_Seconds()
        var result = ""
        if days != 0)
        {
            result = result + days.ToString() + "."
        }
        if hours < 10)
        {
            result = result + "0"
        }
        result = result + hours.ToString() + ":"
        if minutes < 10)
        {
            result = result + "0"
        }
        result = result + minutes.ToString() + ":"
        if seconds < 10)
        {
            result = result + "0"
        }
        result = result + seconds.ToString()
        return result
    }

    public static function FromDays(value: float64): TimeSpan
    {
        return TimeSpan.Interval(value, TimeSpan.TicksPerDay)
    }

    public static function FromHours(value: float64): TimeSpan
    {
        return TimeSpan.Interval(value, TimeSpan.TicksPerHour)
    }

    public static function FromMinutes(value: float64): TimeSpan
    {
        return TimeSpan.Interval(value, TimeSpan.TicksPerMinute)
    }

    public static function FromSeconds(value: float64): TimeSpan
    {
        return TimeSpan.Interval(value, TimeSpan.TicksPerSecond)
    }

    public static function FromMilliseconds(value: float64): TimeSpan
    {
        return TimeSpan.Interval(value, TimeSpan.TicksPerMillisecond)
    }

    public static function FromTicks(value: int64): TimeSpan
    {
        return new TimeSpan(value)
    }

    public static function Compare(t1: TimeSpan, t2: TimeSpan): int32
    {
        if t1.ticks > t2.ticks)
        {
            return 1
        }
        if t1.ticks < t2.ticks)
        {
            return -1
        }
        return 0
    }

    public static function Parse(s: string): TimeSpan
    {
        throw new NotImplementedException()
    }

    public static function TryParse(s: string, result: TimeSpan): bool
    {
        result = TimeSpan.Zero
        return false
    }

    public static function op_Addition(t1: TimeSpan, t2: TimeSpan): TimeSpan
    {
        return t1.Add(t2)
    }

    public static function op_Subtraction(t1: TimeSpan, t2: TimeSpan): TimeSpan
    {
        return t1.Subtract(t2)
    }

    public static function op_UnaryNegation(t: TimeSpan): TimeSpan
    {
        return t.Negate()
    }

    public static function op_UnaryPlus(t: TimeSpan): TimeSpan
    {
        return t
    }

    public static function op_Equality(t1: TimeSpan, t2: TimeSpan): bool
    {
        return t1.ticks == t2.ticks
    }

    public static function op_Inequality(t1: TimeSpan, t2: TimeSpan): bool
    {
        return t1.ticks != t2.ticks
    }

    public static function op_LessThan(t1: TimeSpan, t2: TimeSpan): bool
    {
        return t1.ticks < t2.ticks
    }

    public static function op_LessThanOrEqual(t1: TimeSpan, t2: TimeSpan): bool
    {
        return t1.ticks <= t2.ticks
    }

    public static function op_GreaterThan(t1: TimeSpan, t2: TimeSpan): bool
    {
        return t1.ticks > t2.ticks
    }

    public static function op_GreaterThanOrEqual(t1: TimeSpan, t2: TimeSpan): bool
    {
        return t1.ticks >= t2.ticks
    }

    private static function Interval(value: float64, scale: int64): TimeSpan
    {
        if float64.IsNaN(value))
        {
            throw new ArgumentException("Value cannot be NaN")
        }
        var ticks = int64(value * float64(scale))
        return new TimeSpan(ticks)
    }

    private static function TimeToTicks(hour: int32, minute: int32, second: int32): int64
    {
        var totalSeconds = int64(hour) * 3600 + int64(minute) * 60 + int64(second)
        return totalSeconds * TimeSpan.TicksPerSecond
    }

    private static function TimeToTicks(days: int32, hour: int32, minute: int32, second: int32, millisecond: int32): int64
    {
        var totalMilliseconds = int64(days) * 86400000 + int64(hour) * 3600000 + int64(minute) * 60000 + int64(second) * 1000 + int64(millisecond)
        return totalMilliseconds * TimeSpan.TicksPerMillisecond
    }
}

public class TimeZoneInfo
{
    public static function GetLocalUtcOffset(dateTime: DateTime, flags: TimeZoneInfoOptions): TimeSpan
    {
        var offsetMinutes = unsafe_timezone_get_local_offset()
        return new TimeSpan(0, offsetMinutes, 0)
    }
}

public enum TimeZoneInfoOptions
{
    None = 1
    NoThrowOnInvalidTime = 2
}
