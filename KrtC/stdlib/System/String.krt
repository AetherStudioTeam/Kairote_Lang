namespace System

public class String
{
    private var length: int32
    private var data: char[]

    public function String()
    {
        this.length = 0
        this.data = new char[0]
    }

    public function String(value: char[])
    {
        this.length = value.Length
        this.data = new char[this.length]
        var i = 0
        while i < this.length
        {
            this.data[i] = value[i]
            i = i + 1
        }
    }

    public function Length(): int32
    {
        return this.length
    }

    public function get_Chars(index: int32): char
    {
        return this.data[index]
    }

    public function Substring(startIndex: int32, length: int32): string
    {
        if startIndex < 0
        {
            return ""
        }
        if startIndex >= this.length
        {
            return ""
        }
        if length < 0
        {
            return ""
        }
        if startIndex + length > this.length
        {
            length = this.length - startIndex
        }
        var result = new char[length]
        var i = 0
        while i < length
        {
            result[i] = this.data[startIndex + i]
            i = i + 1
        }
        return new String(result)
    }

    public function IndexOf(c: char): int32
    {
        var i = 0
        while i < this.length
        {
            if this.data[i] == c
            {
                return i
            }
            i = i + 1
        }
        return -1
    }

    public function Contains(s: string): bool
    {
        if s == null
        {
            return false
        }
        if s.Length() == 0
        {
            return true
        }
        var i = 0
        while i <= this.length - s.Length()
        {
            var j = 0
            var found = true
            while j < s.Length()
            {
                if this.data[i + j] != s.get_Chars(j)
                {
                    found = false
                    break
                }
                j = j + 1
            }
            if found
            {
                return true
            }
            i = i + 1
        }
        return false
    }

    public function StartsWith(s: string): bool
    {
        if s == null
        {
            return true
        }
        if s.Length() == 0
        {
            return true
        }
        if s.Length() > this.length
        {
            return false
        }
        var i = 0
        while i < s.Length()
        {
            if this.data[i] != s.get_Chars(i)
            {
                return false
            }
            i = i + 1
        }
        return true
    }

    public function EndsWith(s: string): bool
    {
        if s == null
        {
            return true
        }
        if s.Length() == 0
        {
            return true
        }
        if s.Length() > this.length
        {
            return false
        }
        var offset = this.length - s.Length()
        var i = 0
        while i < s.Length()
        {
            if this.data[offset + i] != s.get_Chars(i)
            {
                return false
            }
            i = i + 1
        }
        return true
    }

    public function Trim(): string
    {
        var start = 0
        var end = this.length - 1
        while start < this.length
        {
            var c = this.data[start]
            if c == ' ' || c == '\t' || c == '\n' || c == '\r'
            {
                start = start + 1
            }
            else
            {
                break
            }
        }
        while end >= start
        {
            var c = this.data[end]
            if c == ' ' || c == '\t' || c == '\n' || c == '\r'
            {
                end = end - 1
            }
            else
            {
                break
            }
        }
        if start > end
        {
            return ""
        }
        return this.Substring(start, end - start + 1)
    }

    public function ToLower(): string
    {
        var result = new char[this.length]
        var i = 0
        while i < this.length
        {
            var c = this.data[i]
            if c >= 'A' && c <= 'Z'
            {
                result[i] = c + 32
            }
            else
            {
                result[i] = c
            }
            i = i + 1
        }
        return new String(result)
    }

    public function ToUpper(): string
    {
        var result = new char[this.length]
        var i = 0
        while i < this.length
        {
            var c = this.data[i]
            if c >= 'a' && c <= 'z'
            {
                result[i] = c - 32
            }
            else
            {
                result[i] = c
            }
            i = i + 1
        }
        return new String(result)
    }

    public function Replace(oldChar: char, newChar: char): string
    {
        var result = new char[this.length]
        var i = 0
        while i < this.length
        {
            if this.data[i] == oldChar
            {
                result[i] = newChar
            }
            else
            {
                result[i] = this.data[i]
            }
            i = i + 1
        }
        return new String(result)
    }

    public static function IsNullOrEmpty(value: string): bool
    {
        return value == null || value.Length() == 0
    }

    public static function Concat(s1: string, s2: string): string
    {
        if s1 == null
        {
            s1 = ""
        }
        if s2 == null
        {
            s2 = ""
        }
        var len1 = s1.Length()
        var len2 = s2.Length()
        var result = new char[len1 + len2]
        var i = 0
        while i < len1
        {
            result[i] = s1.get_Chars(i)
            i = i + 1
        }
        i = 0
        while i < len2
        {
            result[len1 + i] = s2.get_Chars(i)
            i = i + 1
        }
        return new String(result)
    }
}