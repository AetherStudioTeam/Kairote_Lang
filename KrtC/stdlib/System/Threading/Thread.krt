namespace System.Threading

public class Thread
{
    private var threadId: int32
    private var name: string
    private var isAlive: bool
    private var isBackground: bool
    private var priority: ThreadPriority
    private var startCallback: Action

    public static var CurrentThread: Thread = new Thread()

    public function Thread()
    {
        this.threadId = unsafe_thread_get_current_id()
        this.name = null
        this.isAlive = true
        this.isBackground = false
        this.priority = ThreadPriority.Normal
    }

    public function Thread(start: ThreadStart)
    {
        this.threadId = 0
        this.name = null
        this.isAlive = false
        this.isBackground = false
        this.priority = ThreadPriority.Normal
        this.startCallback = start
    }

    public function Thread(start: ParameterizedThreadStart)
    {
        this.threadId = 0
        this.name = null
        this.isAlive = false
        this.isBackground = false
        this.priority = ThreadPriority.Normal
    }

    public function get_ManagedThreadId(): int32
    {
        return this.threadId
    }

    public function get_Name(): string
    {
        return this.name
    }

    public function set_Name(value: string)
    {
        this.name = value
    }

    public function get_IsAlive(): bool
    {
        return this.isAlive
    }

    public function get_IsBackground(): bool
    {
        return this.isBackground
    }

    public function set_IsBackground(value: bool)
    {
        this.isBackground = value
    }

    public function get_IsThreadPoolThread(): bool
    {
        return false
    }

    public function get_Priority(): ThreadPriority
    {
        return this.priority
    }

    public function set_Priority(value: ThreadPriority)
    {
        this.priority = value
    }

    public function get_ThreadState(): ThreadState
    {
        if this.isAlive)
        {
            return ThreadState.Running
        }
        return ThreadState.Unstarted
    }

    public function Start()
    {
        if this.isAlive)
        {
            throw new ThreadStateException("Thread already started")
        }
        if this.startCallback != null)
        {
            this.threadId = unsafe_thread_create(this.startCallback)
            this.isAlive = true
        }
    }

    public function Start(parameter: Object)
    {
        this.Start()
    }

    public function Join()
    {
        if !this.isAlive)
        {
            return
        }
        unsafe_thread_join(this.threadId)
    }

    public function Join(millisecondsTimeout: int32): bool
    {
        if !this.isAlive)
        {
            return true
        }
        return unsafe_thread_join_timeout(this.threadId, millisecondsTimeout)
    }

    public function Abort()
    {
        if this.isAlive)
        {
            unsafe_thread_abort(this.threadId)
            this.isAlive = false
        }
    }

    public function Interrupt()
    {
        if this.isAlive)
        {
            unsafe_thread_interrupt(this.threadId)
        }
    }

    public static function Sleep(millisecondsTimeout: int32)
    {
        if millisecondsTimeout < 0 && millisecondsTimeout != Timeout.Infinite)
        {
            throw new ArgumentOutOfRangeException("millisecondsTimeout")
        }
        unsafe_thread_sleep(millisecondsTimeout)
    }

    public static function Sleep(timeout: TimeSpan)
    {
        var milliseconds = int32(timeout.get_TotalMilliseconds())
        Thread.Sleep(milliseconds)
    }

    public static function Yield(): bool
    {
        return unsafe_thread_yield()
    }

    public static function SpinWait(iterations: int32)
    {
        for var i = 0; i < iterations; i = i + 1)
        {
        }
    }

    public static function MemoryBarrier()
    {
        unsafe_memory_barrier()
    }

    public static function GetDomain(): AppDomain
    {
        return new AppDomain()
    }

    public static function GetCurrentThreadId(): int32
    {
        return unsafe_thread_get_current_id()
    }

    public static function BeginCriticalRegion()
    {
    }

    public static function EndCriticalRegion()
    {
    }
}

public delegate function ThreadStart()

public delegate function ParameterizedThreadStart(obj: Object)

public enum ThreadState
{
    Running = 0
    StopRequested = 1
    SuspendRequested = 2
    Background = 4
    Unstarted = 8
    Stopped = 16
    WaitSleepJoin = 32
    Suspended = 64
    AbortRequested = 128
    Aborted = 256
}

public enum ThreadPriority
{
    Lowest = 0
    BelowNormal = 1
    Normal = 2
    AboveNormal = 3
    Highest = 4
}

public class ThreadStateException : Exception
{
    public function ThreadStateException()
    {
    }

    public function ThreadStateException(message: string)
    {
        this.Message = message
    }
}

public class Timeout
{
    public static var Infinite: int32 = -1
}

public class Monitor
{
    public static function Enter(obj: Object)
    {
        if obj == null)
        {
            throw new ArgumentNullException("obj")
        }
        unsafe_monitor_enter(obj)
    }

    public static function Enter(obj: Object, lockTaken: bool)
    {
        if obj == null)
        {
            throw new ArgumentNullException("obj")
        }
        lockTaken = false
        unsafe_monitor_enter(obj)
        lockTaken = true
    }

    public static function Exit(obj: Object)
    {
        if obj == null)
        {
            throw new ArgumentNullException("obj")
        }
        unsafe_monitor_exit(obj)
    }

    public static function TryEnter(obj: Object): bool
    {
        if obj == null)
        {
            throw new ArgumentNullException("obj")
        }
        return unsafe_monitor_try_enter(obj)
    }

    public static function TryEnter(obj: Object, millisecondsTimeout: int32): bool
    {
        if obj == null)
        {
            throw new ArgumentNullException("obj")
        }
        return unsafe_monitor_try_enter_timeout(obj, millisecondsTimeout)
    }

    public static function Wait(obj: Object): bool
    {
        return Monitor.Wait(obj, Timeout.Infinite)
    }

    public static function Wait(obj: Object, millisecondsTimeout: int32): bool
    {
        if obj == null)
        {
            throw new ArgumentNullException("obj")
        }
        if millisecondsTimeout < 0 && millisecondsTimeout != Timeout.Infinite)
        {
            throw new ArgumentOutOfRangeException("millisecondsTimeout")
        }
        return unsafe_monitor_wait(obj, millisecondsTimeout)
    }

    public static function Pulse(obj: Object)
    {
        if obj == null)
        {
            throw new ArgumentNullException("obj")
        }
        unsafe_monitor_pulse(obj)
    }

    public static function PulseAll(obj: Object)
    {
        if obj == null)
        {
            throw new ArgumentNullException("obj")
        }
        unsafe_monitor_pulse_all(obj)
    }

    public static function IsEntered(obj: Object): bool
    {
        if obj == null)
        {
            throw new ArgumentNullException("obj")
        }
        return unsafe_monitor_is_entered(obj)
    }
}

public class Mutex : WaitHandle
{
    public function Mutex()
    {
        this.Mutex(false)
    }

    public function Mutex(initiallyOwned: bool)
    {
        this.Mutex(initiallyOwned, null)
    }

    public function Mutex(initiallyOwned: bool, name: string)
    {
        this.handle = unsafe_mutex_create(initiallyOwned, name)
    }

    public function WaitOne(): bool
    {
        return this.WaitOne(Timeout.Infinite, false)
    }

    public function WaitOne(millisecondsTimeout: int32, exitContext: bool): bool
    {
        return unsafe_mutex_wait(this.handle, millisecondsTimeout)
    }

    public function ReleaseMutex(): bool
    {
        return unsafe_mutex_release(this.handle)
    }

    public function Close()
    {
        if this.handle != 0)
        {
            unsafe_mutex_close(this.handle)
            this.handle = 0
        }
    }
}

public class Semaphore : WaitHandle
{
    public function Semaphore(initialCount: int32, maximumCount: int32)
    {
        this.Semaphore(initialCount, maximumCount, null)
    }

    public function Semaphore(initialCount: int32, maximumCount: int32, name: string)
    {
        this.handle = unsafe_semaphore_create(initialCount, maximumCount, name)
    }

    public function WaitOne(): bool
    {
        return this.WaitOne(Timeout.Infinite, false)
    }

    public function WaitOne(millisecondsTimeout: int32, exitContext: bool): bool
    {
        return unsafe_semaphore_wait(this.handle, millisecondsTimeout)
    }

    public function Release(): int32
    {
        return this.Release(1)
    }

    public function Release(releaseCount: int32): int32
    {
        return unsafe_semaphore_release(this.handle, releaseCount)
    }

    public function Close()
    {
        if this.handle != 0)
        {
            unsafe_semaphore_close(this.handle)
            this.handle = 0
        }
    }
}

public class AutoResetEvent : EventWaitHandle
{
    public function AutoResetEvent(initialState: bool)
    {
        this.EventWaitHandle(initialState, EventResetMode.AutoReset)
    }
}

public class ManualResetEvent : EventWaitHandle
{
    public function ManualResetEvent(initialState: bool)
    {
        this.EventWaitHandle(initialState, EventResetMode.ManualReset)
    }
}

public class EventWaitHandle : WaitHandle
{
    public function EventWaitHandle(initialState: bool, mode: EventResetMode)
    {
        this.EventWaitHandle(initialState, mode, null)
    }

    public function EventWaitHandle(initialState: bool, mode: EventResetMode, name: string)
    {
        this.handle = unsafe_event_create(initialState, mode == EventResetMode.ManualReset, name)
    }

    public function WaitOne(): bool
    {
        return this.WaitOne(Timeout.Infinite, false)
    }

    public function WaitOne(millisecondsTimeout: int32, exitContext: bool): bool
    {
        return unsafe_event_wait(this.handle, millisecondsTimeout)
    }

    public function Set(): bool
    {
        return unsafe_event_set(this.handle)
    }

    public function Reset(): bool
    {
        return unsafe_event_reset(this.handle)
    }

    public function Close()
    {
        if this.handle != 0)
        {
            unsafe_event_close(this.handle)
            this.handle = 0
        }
    }
}

public enum EventResetMode
{
    AutoReset = 0
    ManualReset = 1
}

public abstract class WaitHandle
{
    protected var handle: int64

    public static var WaitTimeout: int32 = 258

    public function WaitOne(): bool
    {
        return this.WaitOne(Timeout.Infinite, false)
    }

    public function WaitOne(millisecondsTimeout: int32, exitContext: bool): bool
    {
        return false
    }

    public static function WaitAll(waitHandles: WaitHandle[]): bool
    {
        return WaitHandle.WaitAll(waitHandles, Timeout.Infinite, false)
    }

    public static function WaitAll(waitHandles: WaitHandle[], millisecondsTimeout: int32, exitContext: bool): bool
    {
        if waitHandles == null)
        {
            throw new ArgumentNullException("waitHandles")
        }
        if waitHandles.Length == 0)
        {
            throw new ArgumentException("Wait handle array is empty")
        }
        for var i = 0; i < waitHandles.Length; i = i + 1)
        {
            if !waitHandles[i].WaitOne(millisecondsTimeout, exitContext))
            {
                return false
            }
        }
        return true
    }

    public static function WaitAny(waitHandles: WaitHandle[]): int32
    {
        return WaitHandle.WaitAny(waitHandles, Timeout.Infinite, false)
    }

    public static function WaitAny(waitHandles: WaitHandle[], millisecondsTimeout: int32, exitContext: bool): int32
    {
        if waitHandles == null)
        {
            throw new ArgumentNullException("waitHandles")
        }
        if waitHandles.Length == 0)
        {
            throw new ArgumentException("Wait handle array is empty")
        }
        var startTime = Environment.TickCount
        while true)
        {
            for var i = 0; i < waitHandles.Length; i = i + 1)
            {
                if waitHandles[i].WaitOne(0, exitContext))
                {
                    return i
                }
            }
            if millisecondsTimeout != Timeout.Infinite)
            {
                var elapsed = Environment.TickCount - startTime
                if elapsed >= millisecondsTimeout)
                {
                    return WaitHandle.WaitTimeout
                }
            }
            Thread.Sleep(1)
        }
        return WaitHandle.WaitTimeout
    }

    public function Close()
    {
    }

    public function Dispose()
    {
        this.Close()
    }
}

public class Interlocked
{
    public static function Increment(location: int32): int32
    {
        return unsafe_interlocked_increment_int32(location)
    }

    public static function Increment(location: int64): int64
    {
        return unsafe_interlocked_increment_int64(location)
    }

    public static function Decrement(location: int32): int32
    {
        return unsafe_interlocked_decrement_int32(location)
    }

    public static function Decrement(location: int64): int64
    {
        return unsafe_interlocked_decrement_int64(location)
    }

    public static function Add(location1: int32, value: int32): int32
    {
        return unsafe_interlocked_add_int32(location1, value)
    }

    public static function Add(location1: int64, value: int64): int64
    {
        return unsafe_interlocked_add_int64(location1, value)
    }

    public static function Exchange(location1: int32, value: int32): int32
    {
        return unsafe_interlocked_exchange_int32(location1, value)
    }

    public static function Exchange(location1: int64, value: int64): int64
    {
        return unsafe_interlocked_exchange_int64(location1, value)
    }

    public static function Exchange(location1: Object, value: Object): Object
    {
        return unsafe_interlocked_exchange_object(location1, value)
    }

    public static function CompareExchange(location1: int32, value: int32, comparand: int32): int32
    {
        return unsafe_interlocked_compare_exchange_int32(location1, value, comparand)
    }

    public static function CompareExchange(location1: int64, value: int64, comparand: int64): int64
    {
        return unsafe_interlocked_compare_exchange_int64(location1, value, comparand)
    }

    public static function CompareExchange(location1: Object, value: Object, comparand: Object): Object
    {
        return unsafe_interlocked_compare_exchange_object(location1, value, comparand)
    }

    public static function Read(location: int64): int64
    {
        return unsafe_interlocked_read_int64(location)
    }
}

public class SpinLock
{
    private var isHeld: int32

    public function SpinLock(enableThreadOwnerTracking: bool)
    {
        this.isHeld = 0
    }

    public function Enter(lockTaken: bool)
    {
        while Interlocked.CompareExchange(this.isHeld, 1, 0) != 0)
        {
            Thread.SpinWait(1)
        }
        lockTaken = true
    }

    public function TryEnter(lockTaken: bool): bool
    {
        if Interlocked.CompareExchange(this.isHeld, 1, 0) == 0)
        {
            lockTaken = true
            return true
        }
        lockTaken = false
        return false
    }

    public function TryEnter(millisecondsTimeout: int32, lockTaken: bool): bool
    {
        var startTime = Environment.TickCount
        while true)
        {
            if Interlocked.CompareExchange(this.isHeld, 1, 0) == 0)
            {
                lockTaken = true
                return true
            }
            if millisecondsTimeout != Timeout.Infinite)
            {
                var elapsed = Environment.TickCount - startTime
                if elapsed >= millisecondsTimeout)
                {
                    lockTaken = false
                    return false
                }
            }
            Thread.SpinWait(1)
        }
        lockTaken = false
        return false
    }

    public function Exit()
    {
        Interlocked.Exchange(this.isHeld, 0)
    }

    public function Exit(useMemoryBarrier: bool)
    {
        if useMemoryBarrier)
        {
            Thread.MemoryBarrier()
        }
        this.Exit()
    }

    public function get_IsHeld(): bool
    {
        return this.isHeld != 0
    }
}

public class SpinWait
{
    private var count: int32

    public function SpinOnce()
    {
        if this.count < 10)
        {
            Thread.SpinWait(4 << this.count)
        }
        else if this.count % 20 == 19)
        {
            Thread.Sleep(1)
        }
        else
        {
            Thread.Sleep(0)
        }
        this.count = this.count + 1
    }

    public function Reset()
    {
        this.count = 0
    }

    public function get_Count(): int32
    {
        return this.count
    }

    public function get_NextSpinWillYield(): bool
    {
        return this.count >= 10
    }

    public static function SpinUntil(condition: Func<bool>)
    {
        SpinWait.SpinUntil(condition, Timeout.Infinite)
    }

    public static function SpinUntil(condition: Func<bool>, millisecondsTimeout: int32): bool
    {
        var sw = new SpinWait()
        var startTime = Environment.TickCount
        while !condition())
        {
            if millisecondsTimeout != Timeout.Infinite)
            {
                var elapsed = Environment.TickCount - startTime
                if elapsed >= millisecondsTimeout)
                {
                    return false
                }
            }
            sw.SpinOnce()
        }
        return true
    }
}
