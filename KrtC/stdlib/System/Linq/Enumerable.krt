    public static function Average(source: IEnumerable<int32>): float64
    {
        if source == null
        {
            throw new ArgumentNullException("source")
        }
        var sum = int64(0)
        var count = 0
        for var item in source
        {
            sum = sum + int64(item)
            count = count + 1
        }
        if count == 0
        {
            throw new InvalidOperationException("Sequence contains no elements")
        }
        return float64(sum) / float64(count)
    }

    public static function Average(source: IEnumerable<float64>): float64
    {
        if source == null
        {
            throw new ArgumentNullException("source")
        }
        var sum = float64(0)
        var count = 0
        for var item in source
        {
            sum = sum + item
            count = count + 1
        }
        if count == 0
        {
            throw new InvalidOperationException("Sequence contains no elements")
        }
        return sum / float64(count)
    }

    public static function Min(source: IEnumerable<int32>): int32
    {
        if source == null
        {
            throw new ArgumentNullException("source")
        }
        var min = 0
        var first = true
        for var item in source
        {
            if first || item < min
            {
                min = item
                first = false
            }
        }
        if first
        {
            throw new InvalidOperationException("Sequence contains no elements")
        }
        return min
    }

    public static function Min(source: IEnumerable<float64>): float64
    {
        if source == null
        {
            throw new ArgumentNullException("source")
