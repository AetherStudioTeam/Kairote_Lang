        return max
    }

    public static function Distinct<TSource>(source: IEnumerable<TSource>): IEnumerable<TSource>
    {
        return Enumerable.Distinct(source, EqualityComparer<TSource>.Default)
    }

    public static function Distinct<TSource>(source: IEnumerable<TSource>, comparer: IEqualityComparer<TSource>): IEnumerable<TSource>
    {
        if source == null
        {
            throw new ArgumentNullException("source")
        }
        var seen = new Dictionary<TSource, bool>(comparer)
        var result = new List<TSource>()
        for var item in source
        {
            if !seen.ContainsKey(item)
            {
                seen[item] = true
                result.Add(item)
            }
        }
        return result
    }

    public static function Union<TSource>(first: IEnumerable<TSource>, second: IEnumerable<TSource>): IEnumerable<TSource>
    {
        return Enumerable.Union(first, second, EqualityComparer<TSource>.Default)
    }

    public static function Union<TSource>(first: IEnumerable<TSource>, second: IEnumerable<TSource>, comparer: IEqualityComparer<TSource>): IEnumerable<TSource>
    {
        if first == null
        {
            throw new ArgumentNullException("first")
        }
        if second == null
        {
            throw new ArgumentNullException("second")
        }
        var seen = new Dictionary<TSource, bool>(comparer)
        var result = new List<TSource>()
        for var item in first
        {
            if !seen.ContainsKey(item)
            {
                seen[item] = true
                result.Add(item)
            }
        }
        for var item in second
        {
            if !seen.ContainsKey(item)
            {
                seen[item] = true
                result.Add(item)
            }
        }
        return result
    }

    public static function Intersect<TSource>(first: IEnumerable<TSource>, second: IEnumerable<TSource>): IEnumerable<TSource>
    {
        return Enumerable.Intersect(first, second, EqualityComparer<TSource>.Default)
    }

    public static function Intersect<TSource>(first: IEnumerable<TSource>, second: IEnumerable<TSource>, comparer: IEqualityComparer<TSource>): IEnumerable<TSource>
    {
        if first == null
        {
            throw new ArgumentNullException("first")
        }
        if second == null
        {
            throw new ArgumentNullException("second")
        }
        var secondSet = new Dictionary<TSource, bool>(comparer)
        for var item in second
        {
            secondSet[item] = true
        }
        var seen = new Dictionary<TSource, bool>(comparer)
        var result = new List<TSource>()
        for var item in first
        {
            if secondSet.ContainsKey(item) && !seen.ContainsKey(item)
            {
                seen[item] = true
                result.Add(item)
            }
        }
        return result
    }

    public static function Except<TSource>(first: IEnumerable<TSource>, second: IEnumerable<TSource>): IEnumerable<TSource>
    {
        return Enumerable.Except(first, second, EqualityComparer<TSource>.Default)
    }

    public static function Except<TSource>(first: IEnumerable<TSource>, second: IEnumerable<TSource>, comparer: IEqualityComparer<TSource>): IEnumerable<TSource>
    {
        if first == null
        {
            throw new ArgumentNullException("first")
        }
        if second == null
        {
            throw new ArgumentNullException("second")
        }
        var secondSet = new Dictionary<TSource, bool>(comparer)
        for var item in second
        {
            secondSet[item] = true
        }
        var result = new List<TSource>()
        for var item in first
        {
            if !secondSet.ContainsKey(item)
            {
                result.Add(item)
            }
        }
        return result
    }

    public static function Concat<TSource>(first: IEnumerable<TSource>, second: IEnumerable<TSource>): IEnumerable<TSource>
    {
        if first == null
        {
            throw new ArgumentNullException("first")
        }
        if second == null
        {
            throw new ArgumentNullException("second")
        }
        var result = new List<TSource>()
        for var item in first
        {
            result.Add(item)
        }
        for var item in second
        {
            result.Add(item)
        }
        return result
    }

    public static function SequenceEqual<TSource>(first: IEnumerable<TSource>, second: IEnumerable<TSource>): bool
    {
        return Enumerable.SequenceEqual(first, second, EqualityComparer<TSource>.Default)
    }

    public static function SequenceEqual<TSource>(first: IEnumerable<TSource>, second: IEnumerable<TSource>, comparer: IEqualityComparer<TSource>): bool
    {
        if first == null
        {
            throw new ArgumentNullException("first")
        }
        if second == null
        {
            throw new ArgumentNullException("second")
        }
        var e1 = first.GetEnumerator()
        var e2 = second.GetEnumerator()
        while e1.MoveNext()
        {
            if !e2.MoveNext()
            {
                return false
            }
            if !comparer.Equals(e1.Current, e2.Current)
            {
                return false
            }
        }
        return !e2.MoveNext()
    }

    public static function DefaultIfEmpty<TSource>(source: IEnumerable<TSource>): IEnumerable<TSource>
    {
        return Enumerable.DefaultIfEmpty(source, default(TSource))
    }

    public static function DefaultIfEmpty<TSource>(source: IEnumerable<TSource>, defaultValue: TSource): IEnumerable<TSource>
    {
        if source == null
        {
            throw new ArgumentNullException("source")
        }
        var result = new List<TSource>()
        var hasElements = false
        for var item in source
        {
            result.Add(item)
            hasElements = true
        }
        if !hasElements
        {
            result.Add(defaultValue)
        }
        return result
    }

    public static function Empty<TSource>(): IEnumerable<TSource>
    {
        return new List<TSource>()
    }

    public static function Range(start: int32, count: int32): IEnumerable<int32>
    {
        if count < 0
        {
            throw new ArgumentOutOfRangeException("count")
        }
        var result = new List<int32>()
        for var i = 0; i < count; i = i + 1
        {
            result.Add(start + i)
        }
        return result
    }

    public static function Repeat<TResult>(element: TResult, count: int32): IEnumerable<TResult>
    {
        if count < 0
        {
            throw new ArgumentOutOfRangeException("count")
        }
        var result = new List<TResult>()
        for var i = 0; i < count; i = i + 1
        {
            result.Add(element)
        }
        return result
    }

    public static function Cast<TResult>(source: IEnumerable): IEnumerable<TResult>
    {
        if source == null
        {
            throw new ArgumentNullException("source")
        }
        var result = new List<TResult>()
        for var item in source
        {
            result.Add(TResult(item))
        }
        return result
    }

    public static function OfType<TResult>(source: IEnumerable): IEnumerable<TResult>
    {
        if source == null
        {
            throw new ArgumentNullException("source")
        }
        var result = new List<TResult>()
        for var item in source
        {
            if item is TResult)
            {
                result.Add(TResult(item))
            }
        }
        return result
    }
}

public interface IOrderedEnumerable<TElement> : IEnumerable<TElement>
{
}

public class OrderedEnumerable<TElement> : IOrderedEnumerable<TElement>
{
    private var list: List<TElement>

    public function OrderedEnumerable(list: List<TElement>)
    {
        this.list = list
    }

    public function GetEnumerator(): IEnumerator<TElement>
    {
        return this.list.GetEnumerator()
    }
}

public interface IGrouping<TKey, TElement> : IEnumerable<TElement>
{
    function get_Key(): TKey
}

public class Grouping<TKey, TElement> : IGrouping<TKey, TElement>
{
    private var key: TKey
    private var elements: List<TElement>

    public function Grouping(key: TKey, elements: List<TElement>)
    {
        this.key = key
        this.elements = elements
    }

    public function get_Key(): TKey
    {
        return this.key
    }

    public function GetEnumerator(): IEnumerator<TElement>
    {
        return this.elements.GetEnumerator()
    }
}
