namespace System.IO

public abstract class Stream
{
    public static var Null: Stream = new NullStream()

    public function get_CanRead(): bool
    {
        return false
    }

    public function get_CanWrite(): bool
    {
        return false
    }

    public function get_CanSeek(): bool
    {
        return false
    }

    public function get_CanTimeout(): bool
    {
        return false
    }

    public function get_Length(): int64
    {
        throw new NotSupportedException()
    }

    public function get_Position(): int64
    {
        throw new NotSupportedException()
    }

    public function set_Position(value: int64)
    {
        throw new NotSupportedException()
    }

    public function get_ReadTimeout(): int32
    {
        throw new InvalidOperationException()
    }

    public function set_ReadTimeout(value: int32)
    {
        throw new InvalidOperationException()
    }

    public function get_WriteTimeout(): int32
    {
        throw new InvalidOperationException()
    }

    public function set_WriteTimeout(value: int32)
    {
        throw new InvalidOperationException()
    }

    public function CopyTo(destination: Stream)
    {
        this.CopyTo(destination, 81920)
    }

    public function CopyTo(destination: Stream, bufferSize: int32)
    {
        if destination == null
        {
            throw new ArgumentNullException("destination")
        }
        if bufferSize <= 0
        {
            throw new ArgumentOutOfRangeException("bufferSize")
        }
        if !this.CanRead
        {
            throw new NotSupportedException("Stream does not support reading")
        }
        if !destination.CanWrite
        {
            throw new NotSupportedException("Destination stream does not support writing")
        }
        var buffer = new uint8[bufferSize]
        var bytesRead = 0
        while (bytesRead = this.Read(buffer, 0, bufferSize)) > 0
        {
            destination.Write(buffer, 0, bytesRead)
        }
    }

    public function Dispose()
    {
        this.Close()
    }

    public function Close()
    {
    }

    public function Flush()
    {
    }

    public abstract function Read(buffer: uint8[], offset: int32, count: int32): int32

    public function ReadByte(): int32
    {
        var buffer = new uint8[1]
        var r = this.Read(buffer, 0, 1)
        if r == 0
        {
            return -1
        }
        return int32(buffer[0])
    }

    public abstract function Write(buffer: uint8[], offset: int32, count: int32)

    public function WriteByte(value: uint8)
    {
        var buffer = new uint8[1]
        buffer[0] = value
        this.Write(buffer, 0, 1)
    }

    public abstract function Seek(offset: int64, origin: SeekOrigin): int64

    public abstract function SetLength(value: int64)

    public function ReadExactly(buffer: uint8[], offset: int32, count: int32)
    {
        if buffer == null
        {
            throw new ArgumentNullException("buffer")
        }
        if offset < 0
        {
            throw new ArgumentOutOfRangeException("offset")
        }
        if count < 0
        {
            throw new ArgumentOutOfRangeException("count")
        }
        if buffer.Length - offset < count
        {
            throw new ArgumentException("Buffer too small")
        }
        var totalRead = 0
        while totalRead < count
        {
            var read = this.Read(buffer, offset + totalRead, count - totalRead)
            if read == 0
            {
                throw new EndOfStreamException("End of stream reached")
            }
            totalRead = totalRead + read
        }
    }

    public function ReadAtLeast(buffer: uint8[], offset: int32, count: int32, throwOnEndOfStream: bool): int32
    {
        if buffer == null
        {
            throw new ArgumentNullException("buffer")
        }
        if offset < 0
        {
            throw new ArgumentOutOfRangeException("offset")
        }
        if count < 0
        {
            throw new ArgumentOutOfRangeException("count")
        }
        if buffer.Length - offset < count
        {
            throw new ArgumentException("Buffer too small")
        }
        var totalRead = 0
        while totalRead < count
        {
            var read = this.Read(buffer, offset + totalRead, count - totalRead)
            if read == 0
            {
                if throwOnEndOfStream
                {
                    throw new EndOfStreamException("End of stream reached")
                }
                break
            }
            totalRead = totalRead + read
        }
        return totalRead
    }

    public static function Synchronized(stream: Stream): Stream
    {
        if stream == null
        {
            throw new ArgumentNullException("stream")
        }
        return new SynchronizedStream(stream)
    }
}

public enum SeekOrigin
{
    Begin = 0
    Current = 1
    End = 2
}

public class NullStream : Stream
{
    public function get_CanRead(): bool
    {
        return true
    }

    public function get_CanWrite(): bool
    {
        return true
    }

    public function get_CanSeek(): bool
    {
        return true
    }

    public function get_Length(): int64
    {
        return 0
    }

    public function get_Position(): int64
    {
        return 0
    }

    public function set_Position(value: int64)
    {
    }

    public function Read(buffer: uint8[], offset: int32, count: int32): int32
    {
        return 0
    }

    public function Write(buffer: uint8[], offset: int32, count: int32)
    {
    }

    public function Seek(offset: int64, origin: SeekOrigin): int64
    {
        return 0
    }

    public function SetLength(value: int64)
    {
    }

    public function Flush()
    {
    }
}

public class SynchronizedStream : Stream
{
    private var stream: Stream

    public function SynchronizedStream(stream: Stream)
    {
        this.stream = stream
    }

    public function get_CanRead(): bool
    {
        return this.stream.CanRead
    }

    public function get_CanWrite(): bool
    {
        return this.stream.CanWrite
    }

    public function get_CanSeek(): bool
    {
        return this.stream.CanSeek
    }

    public function get_Length(): int64
    {
        return this.stream.Length
    }

    public function get_Position(): int64
    {
        return this.stream.Position
    }

    public function set_Position(value: int64)
    {
        this.stream.Position = value
    }

    public function Read(buffer: uint8[], offset: int32, count: int32): int32
    {
        lock this
        {
            return this.stream.Read(buffer, offset, count)
        }
    }

    public function Write(buffer: uint8[], offset: int32, count: int32)
    {
        lock this
        {
            this.stream.Write(buffer, offset, count)
        }
    }

    public function Seek(offset: int64, origin: SeekOrigin): int64
    {
        lock this
        {
            return this.stream.Seek(offset, origin)
        }
    }

    public function SetLength(value: int64)
    {
        lock this
        {
            this.stream.SetLength(value)
        }
    }

    public function Flush()
    {
        lock this
        {
            this.stream.Flush()
        }
    }
}

public class EndOfStreamException : IOException
{
    public function EndOfStreamException(): base()
    {
    }

    public function EndOfStreamException(message: string): base(message)
    {
    }

    public function EndOfStreamException(message: string, innerException: Exception): base(message, innerException)
    {
    }
}

public class IOException : SystemException
{
    public function IOException(): base()
    {
    }

    public function IOException(message: string): base(message)
    {
    }

    public function IOException(message: string, innerException: Exception): base(message, innerException)
    {
    }

    public function IOException(message: string, hresult: int32)
    {
        this.message = message
    }
}

public class FileNotFoundException : IOException
{
    private var fileName: string

    public function FileNotFoundException(): base()
    {
    }

    public function FileNotFoundException(message: string): base(message)
    {
    }

    public function FileNotFoundException(message: string, innerException: Exception): base(message, innerException)
    {
    }

    public function FileNotFoundException(message: string, fileName: string)
    {
        this.message = message
        this.fileName = fileName
    }

    public function get_FileName(): string
    {
        return this.fileName
    }
}

public class DirectoryNotFoundException : IOException
{
    public function DirectoryNotFoundException(): base()
    {
    }

    public function DirectoryNotFoundException(message: string): base(message)
    {
    }

    public function DirectoryNotFoundException(message: string, innerException: Exception): base(message, innerException)
    {
    }
}

public class PathTooLongException : IOException
{
    public function PathTooLongException(): base()
    {
    }

    public function PathTooLongException(message: string): base(message)
    {
    }

    public function PathTooLongException(message: string, innerException: Exception): base(message, innerException)
    {
    }
}
