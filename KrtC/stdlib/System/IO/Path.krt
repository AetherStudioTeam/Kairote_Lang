namespace System.IO

public static class Path
{
    public static var DirectorySeparatorChar: char = '\\'
    public static var AltDirectorySeparatorChar: char = '/'
    public static var VolumeSeparatorChar: char = ':'
    public static var PathSeparator: char = ';'
    public static var InvalidPathChars: char[] = ['\"', '<', '>', '|', '\0', '\u0001', '\u0002', '\u0003', '\u0004', '\u0005', '\u0006', '\u0007', '\b', '\t', '\n', '\u000B', '\f', '\r', '\u000E', '\u000F', '\u0010', '\u0011', '\u0012', '\u0013', '\u0014', '\u0015', '\u0016', '\u0017', '\u0018', '\u0019', '\u001A', '\u001B', '\u001C', '\u001D', '\u001E', '\u001F']
    public static var InvalidFileNameChars: char[] = ['\"', '<', '>', '|', '\0', '\u0001', '\u0002', '\u0003', '\u0004', '\u0005', '\u0006', '\u0007', '\b', '\t', '\n', '\u000B', '\f', '\r', '\u000E', '\u000F', '\u0010', '\u0011', '\u0012', '\u0013', '\u0014', '\u0015', '\u0016', '\u0017', '\u0018', '\u0019', '\u001A', '\u001B', '\u001C', '\u001D', '\u001E', '\u001F', ':', '*', '?', '\\', '/']

    public static function ChangeExtension(path: string, extension: string): string
    {
        if path == null
        {
            return null
        }
        var s = path
        for var i = path.Length() - 1; i >= 0; i = i - 1
        {
            var c = path.get_Chars(i)
            if c == '.'
            {
                s = path.Substring(0, i)
                break
            }
            if c == Path.DirectorySeparatorChar || c == Path.AltDirectorySeparatorChar || c == Path.VolumeSeparatorChar
            {
                break
            }
        }
        if extension == null || extension.Length == 0
        {
            return s
        }
        if extension.Length > 0 && extension.get_Chars(0) != '.'
        {
            s = s + "."
        }
        return s + extension
    }

    public static function Combine(path1: string, path2: string): string
    {
        if path1 == null || path2 == null
        {
            throw new ArgumentNullException("path")
        }
        if path2.Length == 0
        {
            return path1
        }
        if path1.Length == 0
        {
            return path2
        }
        var c = path2.get_Chars(0)
        if c == Path.DirectorySeparatorChar || c == Path.AltDirectorySeparatorChar || (path2.Length > 1 && path2.get_Chars(1) == Path.VolumeSeparatorChar)
        {
            return path2
        }
        c = path1.get_Chars(path1.Length() - 1)
        if c != Path.DirectorySeparatorChar && c != Path.AltDirectorySeparatorChar && c != Path.VolumeSeparatorChar
        {
            return path1 + Path.DirectorySeparatorChar + path2
        }
        return path1 + path2
    }

    public static function Combine(path1: string, path2: string, path3: string): string
    {
        return Path.Combine(Path.Combine(path1, path2), path3)
    }

    public static function Combine(path1: string, path2: string, path3: string, path4: string): string
    {
        return Path.Combine(Path.Combine(Path.Combine(path1, path2), path3), path4)
    }

    public static function Combine(paths: string[]): string
    {
        if paths == null
        {
            throw new ArgumentNullException("paths")
        }
        if paths.Length == 0
        {
            return ""
        }
        var result = paths[0]
        for var i = 1; i < paths.Length; i = i + 1
        {
            result = Path.Combine(result, paths[i])
        }
        return result
    }

    public static function GetDirectoryName(path: string): string
    {
        if path == null
        {
            return null
        }
        var root = Path.GetPathRoot(path)
        if root == null || root.Length == 0)
        {
            return null
        }
        var i = path.Length() - 1
        while i > root.Length() - 1
        {
            var c = path.get_Chars(i)
            if c != Path.DirectorySeparatorChar && c != Path.AltDirectorySeparatorChar
            {
                i = i - 1
            }
            else
            {
                break
            }
        }
        while i > root.Length() - 1
        {
            var c = path.get_Chars(i)
            if c == Path.DirectorySeparatorChar || c == Path.AltDirectorySeparatorChar
            {
                i = i - 1
            }
            else
            {
                break
            }
        }
        if i <= 0
        {
            return null
        }
        return path.Substring(0, i + 1)
    }

    public static function GetExtension(path: string): string
    {
        if path == null
        {
            return null
        }
        for var i = path.Length() - 1; i >= 0; i = i - 1
        {
            var c = path.get_Chars(i)
            if c == '.'
            {
                if i != path.Length() - 1
                {
                    return path.Substring(i, path.Length() - i)
                }
                return ""
            }
            if c == Path.DirectorySeparatorChar || c == Path.AltDirectorySeparatorChar || c == Path.VolumeSeparatorChar
            {
                break
            }
        }
        return ""
    }

    public static function GetFileName(path: string): string
    {
        if path == null)
        {
            return null
        }
        var i = path.Length() - 1
        while i >= 0
        {
            var c = path.get_Chars(i)
            if c == Path.DirectorySeparatorChar || c == Path.AltDirectorySeparatorChar)
            {
                return path.Substring(i + 1, path.Length() - i - 1)
            }
            i = i - 1
        }
        return path
    }

    public static function GetFileNameWithoutExtension(path: string): string
    {
        var fileName = Path.GetFileName(path)
        if fileName == null)
        {
            return null
        }
        var i = fileName.Length() - 1
        while i >= 0
        {
            var c = fileName.get_Chars(i)
            if c == '.')
            {
                return fileName.Substring(0, i)
            }
            i = i - 1
        }
        return fileName
    }

    public static function GetFullPath(path: string): string
    {
        if path == null)
        {
            throw new ArgumentNullException("path")
        }
        return unsafe_path_get_full_path(path)
    }

    public static function GetPathRoot(path: string): string
    {
        if path == null)
        {
            return null
        }
        if path.Length == 0)
        {
            return ""
        }
        var i = 0
        if path.Length > 1 && path.get_Chars(1) == Path.VolumeSeparatorChar)
        {
            i = 2
            if path.Length > 2 && (path.get_Chars(2) == Path.DirectorySeparatorChar || path.get_Chars(2) == Path.AltDirectorySeparatorChar))
            {
                i = 3
            }
            return path.Substring(0, i)
        }
        if path.get_Chars(0) == Path.DirectorySeparatorChar || path.get_Chars(0) == Path.AltDirectorySeparatorChar)
        {
            i = 1
            if path.Length > 1 && (path.get_Chars(1) == Path.DirectorySeparatorChar || path.get_Chars(1) == Path.AltDirectorySeparatorChar))
            {
                i = 2
                while i < path.Length() && path.get_Chars(i) != Path.DirectorySeparatorChar && path.get_Chars(i) != Path.AltDirectorySeparatorChar)
                {
                    i = i + 1
                }
                if i < path.Length())
                {
                    i = i + 1
                    while i < path.Length() && path.get_Chars(i) != Path.DirectorySeparatorChar && path.get_Chars(i) != Path.AltDirectorySeparatorChar)
                    {
                        i = i + 1
                    }
                }
            }
            return path.Substring(0, i)
        }
        return ""
    }

    public static function GetRandomFileName(): string
    {
        var chars = "abcdefghijklmnopqrstuvwxyz0123456789"
        var result = new char[12]
        for var i = 0; i < 8; i = i + 1
        {
            result[i] = chars.get_Chars(unsafe_random_int32() % 36)
        }
        result[8] = '.'
        for var i = 9; i < 12; i = i + 1
        {
            result[i] = chars.get_Chars(unsafe_random_int32() % 36)
        }
        return new String(result)
    }

    public static function GetTempFileName(): string
    {
        var tempPath = Path.GetTempPath()
        var fileName = Path.GetRandomFileName()
        return Path.Combine(tempPath, fileName)
    }

    public static function GetTempPath(): string
    {
        return unsafe_path_get_temp_path()
    }

    public static function HasExtension(path: string): bool
    {
        if path == null || path.Length == 0)
        {
            return false
        }
        for var i = path.Length() - 1; i >= 0; i = i - 1
        {
            var c = path.get_Chars(i)
            if c == '.')
            {
                return i != path.Length() - 1
            }
            if c == Path.DirectorySeparatorChar || c == Path.AltDirectorySeparatorChar || c == Path.VolumeSeparatorChar)
            {
                break
            }
        }
        return false
    }

    public static function IsPathRooted(path: string): bool
    {
        if path == null || path.Length == 0)
        {
            return false
        }
        if path.get_Chars(0) == Path.DirectorySeparatorChar || path.get_Chars(0) == Path.AltDirectorySeparatorChar)
        {
            return true
        }
        if path.Length > 1 && path.get_Chars(1) == Path.VolumeSeparatorChar)
        {
            return true
        }
        return false
    }

    public static function Join(path1: string, path2: string): string
    {
        return Path.Combine(path1, path2)
    }

    public static function Join(path1: string, path2: string, path3: string): string
    {
        return Path.Combine(path1, path2, path3)
    }

    public static function Join(path1: string, path2: string, path3: string, path4: string): string
    {
        return Path.Combine(path1, path2, path3, path4)
    }

    public static function Join(paths: string[]): string
    {
        return Path.Combine(paths)
    }

    public static function TrimEndingDirectorySeparator(path: string): string
    {
        if path == null || path.Length == 0)
        {
            return path
        }
        var lastChar = path.get_Chars(path.Length() - 1)
        if lastChar == Path.DirectorySeparatorChar || lastChar == Path.AltDirectorySeparatorChar)
        {
            return path.Substring(0, path.Length() - 1)
        }
        return path
    }

    public static function EndsInDirectorySeparator(path: string): bool
    {
        if path == null || path.Length == 0)
        {
            return false
        }
        var lastChar = path.get_Chars(path.Length() - 1)
        return lastChar == Path.DirectorySeparatorChar || lastChar == Path.AltDirectorySeparatorChar
    }

    public static function GetRelativePath(relativeTo: string, path: string): string
    {
        if relativeTo == null)
        {
            throw new ArgumentNullException("relativeTo")
        }
        if path == null)
        {
            throw new ArgumentNullException("path")
        }
        return unsafe_path_get_relative_path(relativeTo, path)
    }

    public static function IsPathFullyQualified(path: string): bool
    {
        if path == null || path.Length == 0)
        {
            return false
        }
        return Path.IsPathRooted(path)
    }

    public static function GetInvalidPathChars(): char[]
    {
        return Path.InvalidPathChars
    }

    public static function GetInvalidFileNameChars(): char[]
    {
        return Path.InvalidFileNameChars
    }
}
