namespace System.IO

public class StreamReader : TextReader
{
    public static var Null: StreamReader = new NullStreamReader()

    private var stream: Stream
    private var encoding: Encoding
    private var decoder: Decoder
    private var byteBuffer: uint8[]
    private var charBuffer: char[]
    private var bytePos: int32
    private var byteLen: int32
    private var charPos: int32
    private var charLen: int32
    private var bufferSize: int32
    private var detectEncoding: bool
    private var checkPreamble: bool
    private var preamble: uint8[]
    private var isBlocked: bool
    private var closable: bool

    public function StreamReader(stream: Stream)
    {
        this.StreamReader(stream, Encoding.UTF8, true, 1024, false)
    }

    public function StreamReader(stream: Stream, detectEncodingFromByteOrderMarks: bool)
    {
        this.StreamReader(stream, Encoding.UTF8, detectEncodingFromByteOrderMarks, 1024, false)
    }

    public function StreamReader(stream: Stream, encoding: Encoding)
    {
        this.StreamReader(stream, encoding, true, 1024, false)
    }

    public function StreamReader(stream: Stream, encoding: Encoding, detectEncodingFromByteOrderMarks: bool)
    {
        this.StreamReader(stream, encoding, detectEncodingFromByteOrderMarks, 1024, false)
    }

    public function StreamReader(stream: Stream, encoding: Encoding, detectEncodingFromByteOrderMarks: bool, bufferSize: int32)
    {
        this.StreamReader(stream, encoding, detectEncodingFromByteOrderMarks, bufferSize, false)
    }

    public function StreamReader(stream: Stream, encoding: Encoding, detectEncodingFromByteOrderMarks: bool, bufferSize: int32, leaveOpen: bool)
    {
        if stream == null)
        {
            throw new ArgumentNullException("stream")
        }
        if encoding == null)
        {
            throw new ArgumentNullException("encoding")
        }
        if bufferSize <= 0)
        {
            throw new ArgumentOutOfRangeException("bufferSize")
        }
        if !stream.CanRead)
        {
            throw new ArgumentException("Stream does not support reading")
        }
        this.stream = stream
        this.encoding = encoding
        this.decoder = encoding.GetDecoder()
        this.bufferSize = bufferSize
        this.byteBuffer = new uint8[bufferSize]
        this.charBuffer = new char[bufferSize]
        this.bytePos = 0
        this.byteLen = 0
        this.charPos = 0
        this.charLen = 0
        this.detectEncoding = detectEncodingFromByteOrderMarks
        this.checkPreamble = encoding.GetPreamble().Length > 0
        this.preamble = encoding.GetPreamble()
        this.isBlocked = false
        this.closable = !leaveOpen
    }

    public function StreamReader(path: string)
    {
        this.StreamReader(path, Encoding.UTF8, true, 1024)
    }

    public function StreamReader(path: string, detectEncodingFromByteOrderMarks: bool)
    {
        this.StreamReader(path, Encoding.UTF8, detectEncodingFromByteOrderMarks, 1024)
    }

    public function StreamReader(path: string, encoding: Encoding)
    {
        this.StreamReader(path, encoding, true, 1024)
    }

    public function StreamReader(path: string, encoding: Encoding, detectEncodingFromByteOrderMarks: bool)
    {
        this.StreamReader(path, encoding, detectEncodingFromByteOrderMarks, 1024)
    }

    public function StreamReader(path: string, encoding: Encoding, detectEncodingFromByteOrderMarks: bool, bufferSize: int32)
    {
        if path == null)
        {
            throw new ArgumentNullException("path")
        }
        if encoding == null)
        {
            throw new ArgumentNullException("encoding")
        }
        if bufferSize <= 0)
        {
            throw new ArgumentOutOfRangeException("bufferSize")
        }
        var stream = new FileStream(path, FileMode.Open, FileAccess.Read, FileShare.Read, bufferSize)
        this.StreamReader(stream, encoding, detectEncodingFromByteOrderMarks, bufferSize, false)
        this.closable = true
    }

    public function get_BaseStream(): Stream
    {
        return this.stream
    }

    public function get_CurrentEncoding(): Encoding
    {
        return this.encoding
    }

    public function get_EndOfStream(): bool
    {
        if this.stream == null)
        {
            throw new ObjectDisposedException("StreamReader")
        }
        if this.charPos < this.charLen)
        {
            return false
        }
        return this.ReadBuffer() == 0
    }

    public function Close()
    {
        this.Dispose()
    }

    public function Dispose()
    {
        if this.closable && this.stream != null)
        {
            this.stream.Close()
        }
        this.stream = null
        this.encoding = null
        this.decoder = null
        this.byteBuffer = null
        this.charBuffer = null
    }

    public function DiscardBufferedData()
    {
        this.byteLen = 0
        this.charLen = 0
        this.charPos = 0
        if this.decoder != null)
        {
            this.decoder.Reset()
        }
        this.isBlocked = false
    }

    public function Peek(): int32
    {
        if this.stream == null)
        {
            throw new ObjectDisposedException("StreamReader")
        }
        if this.charPos == this.charLen)
        {
            if this.isBlocked || this.ReadBuffer() == 0)
            {
                return -1
            }
        }
        return int32(this.charBuffer[this.charPos])
    }

    public function Read(): int32
    {
        if this.stream == null)
        {
            throw new ObjectDisposedException("StreamReader")
        }
        if this.charPos == this.charLen)
        {
            if this.isBlocked || this.ReadBuffer() == 0)
            {
                return -1
            }
        }
        var result = int32(this.charBuffer[this.charPos])
        this.charPos = this.charPos + 1
        return result
    }

    public function Read(buffer: char[], index: int32, count: int32): int32
    {
        if buffer == null)
        {
            throw new ArgumentNullException("buffer")
        }
        if index < 0 || count < 0)
        {
            throw new ArgumentOutOfRangeException("index or count")
        }
        if buffer.Length - index < count)
        {
            throw new ArgumentException("Buffer too small")
        }
        if this.stream == null)
        {
            throw new ObjectDisposedException("StreamReader")
        }
        var charsRead = 0
        var readToUserBuffer = false
        while count > 0)
        {
            var n = this.charLen - this.charPos
            if n == 0)
            {
                n = this.ReadBuffer()
            }
            if n == 0)
            {
                break
            }
            if n > count)
            {
                n = count
            }
            for var i = 0; i < n; i = i + 1)
            {
                buffer[index + i] = this.charBuffer[this.charPos + i]
            }
            this.charPos = this.charPos + n
            index = index + n
            count = count - n
            charsRead = charsRead + n
            readToUserBuffer = true
        }
        return charsRead
    }

    public function ReadToEnd(): string
    {
        if this.stream == null)
        {
            throw new ObjectDisposedException("StreamReader")
        }
        var sb = new StringBuilder()
        var charsRead = 0
        while (charsRead = this.Read(this.charBuffer, 0, this.charBuffer.Length)) > 0)
        {
            sb.Append(this.charBuffer, 0, charsRead)
        }
        return sb.ToString()
    }

    public function ReadLine(): string
    {
        if this.stream == null)
        {
            throw new ObjectDisposedException("StreamReader")
        }
        if this.charPos == this.charLen)
        {
            if this.ReadBuffer() == 0)
            {
                return null
            }
        }
        var sb = new StringBuilder()
        while true)
        {
            var i = this.charPos
            while i < this.charLen)
            {
                var ch = this.charBuffer[i]
                if ch == '\r' || ch == '\n')
                {
                    break
                }
                i = i + 1
            }
            if i < this.charLen)
            {
                for var j = this.charPos; j < i; j = j + 1)
                {
                    sb.Append(this.charBuffer[j])
                }
                this.charPos = i + 1
                if this.charBuffer[i] == '\r')
                {
                    if this.charPos < this.charLen)
                    {
                        if this.charBuffer[this.charPos] == '\n')
                        {
                            this.charPos = this.charPos + 1
                        }
                    }
                    else if this.ReadBuffer() > 0 && this.charBuffer[0] == '\n')
                    {
                        this.charPos = 1
                    }
                }
                return sb.ToString()
            }
            else
            {
                for var j = this.charPos; j < i; j = j + 1)
                {
                    sb.Append(this.charBuffer[j])
                }
                if this.ReadBuffer() == 0)
                {
                    return sb.ToString()
                }
            }
        }
        return null
    }

    public static function ReadAllText(path: string): string
    {
        using var reader = new StreamReader(path)
        return reader.ReadToEnd()
    }

    public static function ReadAllText(path: string, encoding: Encoding): string
    {
        using var reader = new StreamReader(path, encoding)
        return reader.ReadToEnd()
    }

    public static function ReadAllLines(path: string): string[]
    {
        return StreamReader.ReadAllLines(path, Encoding.UTF8)
    }

    public static function ReadAllLines(path: string, encoding: Encoding): string[]
    {
        var lines = new List<string>()
        using var reader = new StreamReader(path, encoding)
        var line = reader.ReadLine()
        while line != null)
        {
            lines.Add(line)
            line = reader.ReadLine()
        }
        return lines.ToArray()
    }

    private function ReadBuffer(): int32
    {
        this.charLen = 0
        this.charPos = 0
        if this.byteLen - this.bytePos < this.preamble.Length && !this.isBlocked)
        {
            if this.bytePos > 0)
            {
                for var i = 0; i < this.byteLen - this.bytePos; i = i + 1)
                {
                    this.byteBuffer[i] = this.byteBuffer[this.bytePos + i]
                }
                this.byteLen = this.byteLen - this.bytePos
                this.bytePos = 0
            }
            var bytesRead = this.stream.Read(this.byteBuffer, this.byteLen, this.byteBuffer.Length - this.byteLen)
            if bytesRead == 0)
            {
                this.isBlocked = true
            }
            this.byteLen = this.byteLen + bytesRead
        }
        if this.byteLen == 0)
        {
            return 0
        }
        if this.detectEncoding && this.byteLen >= 2)
        {
            this.DetectEncoding()
        }
        this.isBlocked = this.byteLen < this.byteBuffer.Length
        var bytesToConvert = this.byteLen - this.bytePos
        if bytesToConvert == 0)
        {
            return 0
        }
        var charsConverted = this.decoder.GetChars(this.byteBuffer, this.bytePos, bytesToConvert, this.charBuffer, 0, false)
        this.charLen = charsConverted
        this.bytePos = this.byteLen
        return this.charLen
    }

    private function DetectEncoding()
    {
        if this.byteLen < 2)
        {
            return
        }
        var b1 = this.byteBuffer[0]
        var b2 = this.byteBuffer[1]
        if b1 == 0xFE && b2 == 0xFF)
        {
            this.encoding = Encoding.BigEndianUnicode
            this.decoder = this.encoding.GetDecoder()
            this.bytePos = 2
            this.detectEncoding = false
        }
        else if b1 == 0xFF && b2 == 0xFE)
        {
            if this.byteLen >= 4 && this.byteBuffer[2] == 0 && this.byteBuffer[3] == 0)
            {
                this.encoding = Encoding.UTF32
                this.decoder = this.encoding.GetDecoder()
                this.bytePos = 4
            }
            else
            {
                this.encoding = Encoding.Unicode
                this.decoder = this.encoding.GetDecoder()
                this.bytePos = 2
            }
            this.detectEncoding = false
        }
        else if this.byteLen >= 3 && b1 == 0xEF && b2 == 0xBB && this.byteBuffer[2] == 0xBF)
        {
            this.encoding = Encoding.UTF8
            this.decoder = this.encoding.GetDecoder()
            this.bytePos = 3
            this.detectEncoding = false
        }
        else if this.byteLen >= 4 && b1 == 0 && b2 == 0 && this.byteBuffer[2] == 0xFE && this.byteBuffer[3] == 0xFF)
        {
            this.encoding = Encoding.GetEncoding(12001)
            this.decoder = this.encoding.GetDecoder()
            this.bytePos = 4
            this.detectEncoding = false
        }
    }
}

public class NullStreamReader : StreamReader
{
    public function NullStreamReader()
    {
    }

    public function get_BaseStream(): Stream
    {
        return Stream.Null
    }

    public function get_CurrentEncoding(): Encoding
    {
        return Encoding.Unicode
    }

    public function get_EndOfStream(): bool
    {
        return true
    }

    public function Peek(): int32
    {
        return -1
    }

    public function Read(): int32
    {
        return -1
    }

    public function Read(buffer: char[], index: int32, count: int32): int32
    {
        return 0
    }

    public function ReadLine(): string
    {
        return null
    }

    public function ReadToEnd(): string
    {
        return ""
    }
}
