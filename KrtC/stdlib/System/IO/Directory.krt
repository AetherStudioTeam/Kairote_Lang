namespace System.IO

public static class Directory
{
    public static function CreateDirectory(path: string): DirectoryInfo
    {
        return Directory.CreateDirectory(path, null)
    }

    public static function CreateDirectory(path: string, directorySecurity: Object): DirectoryInfo
    {
        if path == null)
        {
            throw new ArgumentNullException("path")
        }
        if path.Length == 0)
        {
            throw new ArgumentException("Path is empty")
        }
        var fullPath = Path.GetFullPath(path)
        var result = unsafe_directory_create(fullPath)
        if result != 0)
        {
            throw new IOException("Could not create directory")
        }
        return new DirectoryInfo(fullPath)
    }

    public static function Delete(path: string)
    {
        Directory.Delete(path, false)
    }

    public static function Delete(path: string, recursive: bool)
    {
        if path == null)
        {
            throw new ArgumentNullException("path")
        }
        var fullPath = Path.GetFullPath(path)
        if !Directory.Exists(fullPath))
        {
            throw new DirectoryNotFoundException("Directory not found: " + path)
        }
        if recursive)
        {
            var files = Directory.GetFiles(fullPath)
            for var i = 0; i < files.Length; i = i + 1
            {
                File.Delete(files[i])
            }
            var dirs = Directory.GetDirectories(fullPath)
            for var i = 0; i < dirs.Length; i = i + 1
            {
                Directory.Delete(dirs[i], true)
            }
        }
        var result = unsafe_directory_delete(fullPath)
        if result != 0)
        {
            throw new IOException("Could not delete directory")
        }
    }

    public static function Exists(path: string): bool
    {
        if path == null)
        {
            return false
        }
        return unsafe_directory_exists(path)
    }

    public static function GetCreationTime(path: string): DateTime
    {
        return Directory.GetCreationTimeUtc(path).ToLocalTime()
    }

    public static function GetCreationTimeUtc(path: string): DateTime
    {
        if path == null)
        {
            throw new ArgumentNullException("path")
        }
        var ticks = unsafe_directory_get_creation_time(path)
        return new DateTime(ticks)
    }

    public static function GetLastAccessTime(path: string): DateTime
    {
        return Directory.GetLastAccessTimeUtc(path).ToLocalTime()
    }

    public static function GetLastAccessTimeUtc(path: string): DateTime
    {
        if path == null)
        {
            throw new ArgumentNullException("path")
        }
        var ticks = unsafe_directory_get_last_access_time(path)
        return new DateTime(ticks)
    }

    public static function GetLastWriteTime(path: string): DateTime
    {
        return Directory.GetLastWriteTimeUtc(path).ToLocalTime()
    }

    public static function GetLastWriteTimeUtc(path: string): DateTime
    {
        if path == null)
        {
            throw new ArgumentNullException("path")
        }
        var ticks = unsafe_directory_get_last_write_time(path)
        return new DateTime(ticks)
    }

    public static function SetCreationTime(path: string, creationTime: DateTime)
    {
        Directory.SetCreationTimeUtc(path, creationTime.ToUniversalTime())
    }

    public static function SetCreationTimeUtc(path: string, creationTime: DateTime)
    {
        if path == null)
        {
            throw new ArgumentNullException("path")
        }
        unsafe_directory_set_creation_time(path, creationTime.get_Ticks())
    }

    public static function SetLastAccessTime(path: string, lastAccessTime: DateTime)
    {
        Directory.SetLastAccessTimeUtc(path, lastAccessTime.ToUniversalTime())
    }

    public static function SetLastAccessTimeUtc(path: string, lastAccessTime: DateTime)
    {
        if path == null)
        {
            throw new ArgumentNullException("path")
        }
        unsafe_directory_set_last_access_time(path, lastAccessTime.get_Ticks())
    }

    public static function SetLastWriteTime(path: string, lastWriteTime: DateTime)
    {
        Directory.SetLastWriteTimeUtc(path, lastWriteTime.ToUniversalTime())
    }

    public static function SetLastWriteTimeUtc(path: string, lastWriteTime: DateTime)
    {
        if path == null)
        {
            throw new ArgumentNullException("path")
        }
        unsafe_directory_set_last_write_time(path, lastWriteTime.get_Ticks())
    }

    public static function GetFiles(path: string): string[]
    {
        return Directory.GetFiles(path, "*", SearchOption.TopDirectoryOnly)
    }

    public static function GetFiles(path: string, searchPattern: string): string[]
    {
        return Directory.GetFiles(path, searchPattern, SearchOption.TopDirectoryOnly)
    }

    public static function GetFiles(path: string, searchPattern: string, searchOption: SearchOption): string[]
    {
        if path == null)
        {
            throw new ArgumentNullException("path")
        }
        if searchPattern == null)
        {
            throw new ArgumentNullException("searchPattern")
        }
        var files = new List<string>()
        Directory.GetFilesInternal(path, searchPattern, searchOption, files)
        return files.ToArray()
    }

    private static function GetFilesInternal(path: string, searchPattern: string, searchOption: SearchOption, files: List<string>)
    {
        var entries = unsafe_directory_get_files(path, searchPattern)
        for var i = 0; i < entries.Length; i = i + 1
        {
            files.Add(entries[i])
        }
        if searchOption == SearchOption.AllDirectories)
        {
            var dirs = Directory.GetDirectories(path)
            for var i = 0; i < dirs.Length; i = i + 1
            {
                Directory.GetFilesInternal(dirs[i], searchPattern, searchOption, files)
            }
        }
    }

    public static function GetDirectories(path: string): string[]
    {
        return Directory.GetDirectories(path, "*", SearchOption.TopDirectoryOnly)
    }

    public static function GetDirectories(path: string, searchPattern: string): string[]
    {
        return Directory.GetDirectories(path, searchPattern, SearchOption.TopDirectoryOnly)
    }

    public static function GetDirectories(path: string, searchPattern: string, searchOption: SearchOption): string[]
    {
        if path == null)
        {
            throw new ArgumentNullException("path")
        }
        if searchPattern == null)
        {
            throw new ArgumentNullException("searchPattern")
        }
        var dirs = new List<string>()
        Directory.GetDirectoriesInternal(path, searchPattern, searchOption, dirs)
        return dirs.ToArray()
    }

    private static function GetDirectoriesInternal(path: string, searchPattern: string, searchOption: SearchOption, dirs: List<string>)
    {
        var entries = unsafe_directory_get_directories(path, searchPattern)
        for var i = 0; i < entries.Length; i = i + 1
        {
            dirs.Add(entries[i])
        }
        if searchOption == SearchOption.AllDirectories)
        {
            for var i = 0; i < entries.Length; i = i + 1
            {
                Directory.GetDirectoriesInternal(entries[i], searchPattern, searchOption, dirs)
            }
        }
    }

    public static function GetFileSystemEntries(path: string): string[]
    {
        return Directory.GetFileSystemEntries(path, "*", SearchOption.TopDirectoryOnly)
    }

    public static function GetFileSystemEntries(path: string, searchPattern: string): string[]
    {
        return Directory.GetFileSystemEntries(path, searchPattern, SearchOption.TopDirectoryOnly)
    }

    public static function GetFileSystemEntries(path: string, searchPattern: string, searchOption: SearchOption): string[]
    {
        var files = Directory.GetFiles(path, searchPattern, searchOption)
        var dirs = Directory.GetDirectories(path, searchPattern, searchOption)
        var result = new List<string>()
        for var i = 0; i < files.Length; i = i + 1
        {
            result.Add(files[i])
        }
        for var i = 0; i < dirs.Length; i = i + 1
        {
            result.Add(dirs[i])
        }
        return result.ToArray()
    }

    public static function EnumerateFiles(path: string): IEnumerable<string>
    {
        return Directory.EnumerateFiles(path, "*", SearchOption.TopDirectoryOnly)
    }

    public static function EnumerateFiles(path: string, searchPattern: string): IEnumerable<string>
    {
        return Directory.EnumerateFiles(path, searchPattern, SearchOption.TopDirectoryOnly)
    }

    public static function EnumerateFiles(path: string, searchPattern: string, searchOption: SearchOption): IEnumerable<string>
    {
        return Directory.GetFiles(path, searchPattern, searchOption)
    }

    public static function EnumerateDirectories(path: string): IEnumerable<string>
    {
        return Directory.EnumerateDirectories(path, "*", SearchOption.TopDirectoryOnly)
    }

    public static function EnumerateDirectories(path: string, searchPattern: string): IEnumerable<string>
    {
        return Directory.EnumerateDirectories(path, searchPattern, SearchOption.TopDirectoryOnly)
    }

    public static function EnumerateDirectories(path: string, searchPattern: string, searchOption: SearchOption): IEnumerable<string>
    {
        return Directory.GetDirectories(path, searchPattern, searchOption)
    }

    public static function EnumerateFileSystemEntries(path: string): IEnumerable<string>
    {
        return Directory.EnumerateFileSystemEntries(path, "*", SearchOption.TopDirectoryOnly)
    }

    public static function EnumerateFileSystemEntries(path: string, searchPattern: string): IEnumerable<string>
    {
        return Directory.EnumerateFileSystemEntries(path, searchPattern, SearchOption.TopDirectoryOnly)
    }

    public static function EnumerateFileSystemEntries(path: string, searchPattern: string, searchOption: SearchOption): IEnumerable<string>
    {
        return Directory.GetFileSystemEntries(path, searchPattern, searchOption)
    }

    public static function GetParent(path: string): DirectoryInfo
    {
        if path == null)
        {
            throw new ArgumentNullException("path")
        }
        var fullPath = Path.GetFullPath(path)
        var parentPath = Path.GetDirectoryName(fullPath)
        if parentPath == null || parentPath.Length == 0)
        {
            return null
        }
        return new DirectoryInfo(parentPath)
    }

    public static function GetDirectoryRoot(path: string): string
    {
        if path == null)
        {
            throw new ArgumentNullException("path")
        }
        var fullPath = Path.GetFullPath(path)
        return Path.GetPathRoot(fullPath)
    }

    public static function GetCurrentDirectory(): string
    {
        return unsafe_directory_get_current()
    }

    public static function SetCurrentDirectory(path: string)
    {
        if path == null)
        {
            throw new ArgumentNullException("path")
        }
        var result = unsafe_directory_set_current(path)
        if result != 0)
        {
            throw new IOException("Could not set current directory")
        }
    }

    public static function Move(sourceDirName: string, destDirName: string)
    {
        if sourceDirName == null)
        {
            throw new ArgumentNullException("sourceDirName")
        }
        if destDirName == null)
        {
            throw new ArgumentNullException("destDirName")
        }
        if !Directory.Exists(sourceDirName))
        {
            throw new DirectoryNotFoundException("Source directory not found")
        }
        if Directory.Exists(destDirName))
        {
            throw new IOException("Destination directory already exists")
        }
        var result = unsafe_directory_move(sourceDirName, destDirName)
        if result != 0)
        {
            throw new IOException("Could not move directory")
        }
    }

    public static function GetLogicalDrives(): string[]
    {
        return unsafe_directory_get_logical_drives()
    }
}

public enum SearchOption
{
    TopDirectoryOnly = 0
    AllDirectories = 1
}

public class DirectoryInfo : FileSystemInfo
{
    public function DirectoryInfo(path: string)
    {
        if path == null)
        {
            throw new ArgumentNullException("path")
        }
        this.FullPath = Path.GetFullPath(path)
        this.OriginalPath = path
        this.Refresh()
    }

    public function get_Name(): string
    {
        return Path.GetFileName(this.FullPath)
    }

    public function get_Parent(): DirectoryInfo
    {
        var parentPath = Path.GetDirectoryName(this.FullPath)
        if parentPath == null || parentPath.Length == 0)
        {
            return null
        }
        return new DirectoryInfo(parentPath)
    }

    public function get_Root(): DirectoryInfo
    {
        var rootPath = Path.GetPathRoot(this.FullPath)
        if rootPath == null || rootPath.Length == 0)
        {
            return null
        }
        return new DirectoryInfo(rootPath)
    }

    public function Create()
    {
        Directory.CreateDirectory(this.FullPath)
    }

    public function Create(directorySecurity: Object)
    {
        Directory.CreateDirectory(this.FullPath, directorySecurity)
    }

    public function CreateSubdirectory(path: string): DirectoryInfo
    {
        var fullPath = Path.Combine(this.FullPath, path)
        return Directory.CreateDirectory(fullPath)
    }

    public function CreateSubdirectory(path: string, directorySecurity: Object): DirectoryInfo
    {
        var fullPath = Path.Combine(this.FullPath, path)
        return Directory.CreateDirectory(fullPath, directorySecurity)
    }

    public function Delete()
    {
        Directory.Delete(this.FullPath, false)
    }

    public function Delete(recursive: bool)
    {
        Directory.Delete(this.FullPath, recursive)
    }

    public function GetFiles(): FileInfo[]
    {
        return this.GetFiles("*", SearchOption.TopDirectoryOnly)
    }

    public function GetFiles(searchPattern: string): FileInfo[]
    {
        return this.GetFiles(searchPattern, SearchOption.TopDirectoryOnly)
    }

    public function GetFiles(searchPattern: string, searchOption: SearchOption): FileInfo[]
    {
        var files = Directory.GetFiles(this.FullPath, searchPattern, searchOption)
        var result = new FileInfo[files.Length]
        for var i = 0; i < files.Length; i = i + 1
        {
            result[i] = new FileInfo(files[i])
        }
        return result
    }

    public function GetDirectories(): DirectoryInfo[]
    {
        return this.GetDirectories("*", SearchOption.TopDirectoryOnly)
    }

    public function GetDirectories(searchPattern: string): DirectoryInfo[]
    {
        return this.GetDirectories(searchPattern, SearchOption.TopDirectoryOnly)
    }

    public function GetDirectories(searchPattern: string, searchOption: SearchOption): DirectoryInfo[]
    {
        var dirs = Directory.GetDirectories(this.FullPath, searchPattern, searchOption)
        var result = new DirectoryInfo[dirs.Length]
        for var i = 0; i < dirs.Length; i = i + 1
        {
            result[i] = new DirectoryInfo(dirs[i])
        }
        return result
    }

    public function GetFileSystemInfos(): FileSystemInfo[]
    {
        return this.GetFileSystemInfos("*", SearchOption.TopDirectoryOnly)
    }

    public function GetFileSystemInfos(searchPattern: string): FileSystemInfo[]
    {
        return this.GetFileSystemInfos(searchPattern, SearchOption.TopDirectoryOnly)
    }

    public function GetFileSystemInfos(searchPattern: string, searchOption: SearchOption): FileSystemInfo[]
    {
        var entries = Directory.GetFileSystemEntries(this.FullPath, searchPattern, searchOption)
        var result = new List<FileSystemInfo>()
        for var i = 0; i < entries.Length; i = i + 1
        {
            if Directory.Exists(entries[i]))
            {
                result.Add(new DirectoryInfo(entries[i]))
            }
            else
            {
                result.Add(new FileInfo(entries[i]))
            }
        }
        return result.ToArray()
    }

    public function MoveTo(destDirName: string)
    {
        Directory.Move(this.FullPath, destDirName)
        this.FullPath = Path.GetFullPath(destDirName)
    }

    public function ToString(): string
    {
        return this.OriginalPath
    }
}

public abstract class FileSystemInfo
{
    protected var FullPath: string
    protected var OriginalPath: string

    public function get_FullName(): string
    {
        return this.FullPath
    }

    public function get_Extension(): string
    {
        return Path.GetExtension(this.FullPath)
    }

    public function get_Exists(): bool
    {
        return Directory.Exists(this.FullPath)
    }

    public function get_CreationTime(): DateTime
    {
        return Directory.GetCreationTime(this.FullPath)
    }

    public function set_CreationTime(value: DateTime)
    {
        Directory.SetCreationTime(this.FullPath, value)
    }

    public function get_CreationTimeUtc(): DateTime
    {
        return Directory.GetCreationTimeUtc(this.FullPath)
    }

    public function set_CreationTimeUtc(value: DateTime)
    {
        Directory.SetCreationTimeUtc(this.FullPath, value)
    }

    public function get_LastAccessTime(): DateTime
    {
        return Directory.GetLastAccessTime(this.FullPath)
    }

    public function set_LastAccessTime(value: DateTime)
    {
        Directory.SetLastAccessTime(this.FullPath, value)
    }

    public function get_LastAccessTimeUtc(): DateTime
    {
        return Directory.GetLastAccessTimeUtc(this.FullPath)
    }

    public function set_LastAccessTimeUtc(value: DateTime)
    {
        Directory.SetLastAccessTimeUtc(this.FullPath, value)
    }

    public function get_LastWriteTime(): DateTime
    {
        return Directory.GetLastWriteTime(this.FullPath)
    }

    public function set_LastWriteTime(value: DateTime)
    {
        Directory.SetLastWriteTime(this.FullPath, value)
    }

    public function get_LastWriteTimeUtc(): DateTime
    {
        return Directory.GetLastWriteTimeUtc(this.FullPath)
    }

    public function set_LastWriteTimeUtc(value: DateTime)
    {
        Directory.SetLastWriteTimeUtc(this.FullPath, value)
    }

    public function get_Attributes(): FileAttributes
    {
        return File.GetAttributes(this.FullPath)
    }

    public function set_Attributes(value: FileAttributes)
    {
        File.SetAttributes(this.FullPath, value)
    }

    public function Refresh()
    {
    }

    public abstract function ToString(): string
}

public class FileInfo : FileSystemInfo
{
    public function FileInfo(fileName: string)
    {
        if fileName == null)
        {
            throw new ArgumentNullException("fileName")
        }
        this.FullPath = Path.GetFullPath(fileName)
        this.OriginalPath = fileName
        this.Refresh()
    }

    public function get_Name(): string
    {
        return Path.GetFileName(this.FullPath)
    }

    public function get_Directory(): DirectoryInfo
    {
        var dirPath = Path.GetDirectoryName(this.FullPath)
        if dirPath == null || dirPath.Length == 0)
        {
            return null
        }
        return new DirectoryInfo(dirPath)
    }

    public function get_DirectoryName(): string
    {
        return Path.GetDirectoryName(this.FullPath)
    }

    public function get_IsReadOnly(): bool
    {
        return (this.Attributes & FileAttributes.ReadOnly) == FileAttributes.ReadOnly
    }

    public function set_IsReadOnly(value: bool)
    {
        if value)
        {
            this.Attributes = this.Attributes | FileAttributes.ReadOnly
        }
        else
        {
            this.Attributes = this.Attributes & ~FileAttributes.ReadOnly
        }
    }

    public function get_Exists(): bool
    {
        return File.Exists(this.FullPath)
    }

    public function get_Length(): int64
    {
        if !this.Exists)
        {
            throw new FileNotFoundException("File not found", this.FullPath)
        }
        return unsafe_file_get_size_by_path(this.FullPath)
    }

    public function Create(): FileStream
    {
        return File.Create(this.FullPath)
    }

    public function OpenRead(): FileStream
    {
        return File.OpenRead(this.FullPath)
    }

    public function OpenWrite(): FileStream
    {
        return File.OpenWrite(this.FullPath)
    }

    public function Open(mode: FileMode): FileStream
    {
        return new FileStream(this.FullPath, mode)
    }

    public function Open(mode: FileMode, access: FileAccess): FileStream
    {
        return new FileStream(this.FullPath, mode, access)
    }

    public function Open(mode: FileMode, access: FileAccess, share: FileShare): FileStream
    {
        return new FileStream(this.FullPath, mode, access, share)
    }

    public function MoveTo(destFileName: string)
    {
        File.Move(this.FullPath, destFileName, false)
        this.FullPath = Path.GetFullPath(destFileName)
    }

    public function MoveTo(destFileName: string, overwrite: bool)
    {
        File.Move(this.FullPath, destFileName, overwrite)
        this.FullPath = Path.GetFullPath(destFileName)
    }

    public function CopyTo(destFileName: string): FileInfo
    {
        return this.CopyTo(destFileName, false)
    }

    public function CopyTo(destFileName: string, overwrite: bool): FileInfo
    {
        File.Copy(this.FullPath, destFileName, overwrite)
        return new FileInfo(destFileName)
    }

    public function Replace(destinationFileName: string, destinationBackupFileName: string)
    {
        File.Replace(this.FullPath, destinationFileName, destinationBackupFileName, false)
    }

    public function Replace(destinationFileName: string, destinationBackupFileName: string, ignoreMetadataErrors: bool)
    {
        File.Replace(this.FullPath, destinationFileName, destinationBackupFileName, ignoreMetadataErrors)
    }

    public function Delete()
    {
        File.Delete(this.FullPath)
    }

    public function ToString(): string
    {
        return this.OriginalPath
    }
}
