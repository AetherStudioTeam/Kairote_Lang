namespace System

public static class Math
{
    public static function AbsInt(value: int32): int32
    {
        if value < 0
        {
            return -value
        }
        return value
    }

    public static function MaxInt(a: int32, b: int32): int32
    {
        if a > b
        {
            return a
        }
        return b
    }

    public static function MinInt(a: int32, b: int32): int32
    {
        if a < b
        {
            return a
        }
        return b
    }

    public static function Floor(value: float64): float64
    {
        var i = int64(value)
        if value >= 0.0
        {
            return float64(i)
        }
        if float64(i) == value
        {
            return value
        }
        return float64(i - 1)
    }

    public static function Ceiling(value: float64): float64
    {
        var i = int64(value)
        if value <= 0.0
        {
            return float64(i)
        }
        if float64(i) == value
        {
            return value
        }
        return float64(i + 1)
    }

    public static function Round(value: float64): float64
    {
        if value >= 0.0
        {
            return float64(int64(value + 0.5))
        }
        return float64(int64(value - 0.5))
    }

    public static function Sqrt(value: float64): float64
    {
        if value < 0.0
        {
            return 0.0
        }
        if value == 0.0
        {
            return 0.0
        }
        var x = value
        var prev = 0.0
        while x != prev
        {
            prev = x
            x = (x + value / x) / 2.0
        }
        return x
    }

    public static function ClampInt(value: int32, min: int32, max: int32): int32
    {
        if value < min
        {
            return min
        }
        if value > max
        {
            return max
        }
        return value
    }
}