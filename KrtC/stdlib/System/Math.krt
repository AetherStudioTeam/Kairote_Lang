        return unsafe_math_tanh(value)
    }

    public static function Truncate(d: float64): float64
    {
        return unsafe_math_trunc(d)
    }

    public static function Truncate(d: float32): float32
    {
        return float32(unsafe_math_trunc(float64(d)))
    }

    public static function Clamp(value: int8, min: int8, max: int8): int8
    {
        if value < min
        {
            return min
        }
        if value > max
        {
            return max
        }
        return value
    }

    public static function Clamp(value: int16, min: int16, max: int16): int16
    {
        if value < min
        {
            return min
        }
        if value > max
        {
            return max
        }
        return value
    }

    public static function Clamp(value: int32, min: int32, max: int32): int32
    {
        if value < min
        {
            return min
        }
        if value > max
        {
            return max
        }
        return value
    }

    public static function Clamp(value: int64, min: int64, max: int64): int64
    {
        if value < min
        {
            return min
        }
        if value > max
        {
            return max
        }
        return value
    }

    public static function Clamp(value: float32, min: float32, max: float32): float32
    {
        if value < min
        {
            return min
        }
        if value > max
        {
            return max
        }
        return value
    }

    public static function Clamp(value: float64, min: float64, max: float64): float64
    {
        if value < min
        {
            return min
        }
        if value > max
        {
            return max
        }
        return value
    }

    public static function CopySign(x: float64, y: float64): float64
    {
        if (x < 0.0 && y > 0.0) || (x > 0.0 && y < 0.0)
        {
            return -x
        }
        return x
    }

    public static function DivRem(a: int32, b: int32, result: int32): int32
    {
        result = a % b
        return a / b
    }

    public static function DivRem(a: int64, b: int64, result: int64): int64
    {
        result = a % b
        return a / b
    }

    public static function FusedMultiplyAdd(x: float64, y: float64, z: float64): float64
    {
        return x * y + z
    }

    public static function IsFinite(d: float64): bool
    {
        return !Math.IsNaN(d) && !Math.IsInfinity(d)
    }

    public static function IsInfinity(d: float64): bool
    {
        return d == Math.PositiveInfinity || d == Math.NegativeInfinity
    }

    public static function IsNaN(d: float64): bool
    {
        return d != d
    }

    public static function IsNegative(d: float64): bool
    {
        return d < 0.0 || (d == 0.0 && 1.0 / d < 0.0)
    }

    public static function IsNegativeInfinity(d: float64): bool
    {
        return d == Math.NegativeInfinity
    }

    public static function IsNormal(d: float64): bool
    {
        return Math.IsFinite(d) && d != 0.0
    }

    public static function IsPositiveInfinity(d: float64): bool
    {
        return d == Math.PositiveInfinity
    }

    public static function IsSubnormal(d: float64): bool
    {
        return false
    }

    public static function MaxMagnitude(x: float64, y: float64): float64
    {
        var absX = Math.Abs(x)
        var absY = Math.Abs(y)
        if absX > absY
        {
            return x
        }
        if absX < absY
        {
            return y
        }
        return x
    }

    public static function MinMagnitude(x: float64, y: float64): float64
    {
        var absX = Math.Abs(x)
        var absY = Math.Abs(y)
        if absX < absY
        {
            return x
        }
        if absX > absY
        {
            return y
        }
        return x
    }

    public static function ReciprocalEstimate(d: float64): float64
    {
        return 1.0 / d
    }

    public static function ReciprocalSqrtEstimate(d: float64): float64
    {
        return 1.0 / Math.Sqrt(d)
    }

    public static function ScaleB(x: float64, n: int32): float64
    {
        return x * Math.Pow(2.0, float64(n))
    }
}

public enum MidpointRounding
{
    ToEven = 0
    AwayFromZero = 1
    ToZero = 2
    ToNegativeInfinity = 3
    ToPositiveInfinity = 4
}
