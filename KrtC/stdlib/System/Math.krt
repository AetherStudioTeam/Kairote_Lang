namespace System

public static class Math
{
    public static var PI: float64 = 3.14159265358979323846
    public static var E: float64 = 2.71828182845904523536
    public static var Tau: float64 = 6.28318530717958647692
    public static var Epsilon: float64 = 2.22044604925031308085e-16
    public static var PositiveInfinity: float64 = 1.0 / 0.0
    public static var NegativeInfinity: float64 = -1.0 / 0.0
    public static var NaN: float64 = 0.0 / 0.0

    public static function Abs(value: int8): int8
    {
        if value < 0
        {
            return -value
        }
        return value
    }

    public static function Abs(value: int16): int16
    {
        if value < 0
        {
            return -value
        }
        return value
    }

    public static function Abs(value: int32): int32
    {
        if value < 0
        {
            return -value
        }
        return value
    }

    public static function Abs(value: int64): int64
    {
        if value < 0
        {
            return -value
        }
        return value
    }

    public static function Abs(value: float32): float32
    {
        if value < 0.0
        {
            return -value
        }
        return value
    }

    public static function Abs(value: float64): float64
    {
        if value < 0.0
        {
            return -value
        }
        return value
    }

    public static function Acos(d: float64): float64
    {
        return unsafe_math_acos(d)
    }

    public static function Acosh(d: float64): float64
    {
        return unsafe_math_acosh(d)
    }

    public static function Asin(d: float64): float64
