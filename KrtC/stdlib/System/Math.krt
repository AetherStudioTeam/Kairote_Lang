        return unsafe_math_asinh(d)
    }

    public static function Atan(d: float64): float64
    {
        return unsafe_math_atan(d)
    }

    public static function Atan2(y: float64, x: float64): float64
    {
        return unsafe_math_atan2(y, x)
    }

    public static function Atanh(d: float64): float64
    {
        return unsafe_math_atanh(d)
    }

    public static function Cbrt(d: float64): float64
    {
        return unsafe_math_cbrt(d)
    }

    public static function Ceiling(a: float64): float64
    {
        return unsafe_math_ceil(a)
    }

    public static function Ceiling(a: float32): float32
    {
        return float32(unsafe_math_ceil(float64(a)))
    }

    public static function Cos(d: float64): float64
    {
        return unsafe_math_cos(d)
    }

    public static function Cosh(value: float64): float64
    {
        return unsafe_math_cosh(value)
