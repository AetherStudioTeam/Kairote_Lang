    public static function Sqrt(d: float64): float64
    {
        return unsafe_math_sqrt(d)
    }

    public static function Sqrt(d: float32): float32
    {
        return float32(unsafe_math_sqrt(float64(d)))
    }

    public static function Tan(a: float64): float64
    {
        return unsafe_math_tan(a)
    }

    public static function Tanh(value: float64): float64
