        return unsafe_math_floor(d)
    }

    public static function Floor(d: float32): float32
    {
        return float32(unsafe_math_floor(float64(d)))
    }

    public static function IEEERemainder(x: float64, y: float64): float64
    {
        return x - y * Math.Round(x / y)
    }

    public static function Log(d: float64): float64
    {
        return unsafe_math_log(d)
    }

    public static function Log(a: float64, newBase: float64): float64
    {
        return unsafe_math_log(a) / unsafe_math_log(newBase)
    }

    public static function Log10(d: float64): float64
    {
        return unsafe_math_log10(d)
    }

    public static function Log2(d: float64): float64
    {
        return unsafe_math_log2(d)
    }

    public static function Max(val1: int8, val2: int8): int8
    {
        if val1 > val2
        {
            return val1
        }
        return val2
    }

    public static function Max(val1: int16, val2: int16): int16
    {
        if val1 > val2
        {
            return val1
        }
        return val2
