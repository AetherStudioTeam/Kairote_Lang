    public static function Pow(x: float64, y: float64): float64
    {
        return unsafe_math_pow(x, y)
    }

    public static function Round(a: float64): float64
    {
        return unsafe_math_round(a)
    }

    public static function Round(a: float64, digits: int32): float64
    {
        var power = Math.Pow(10.0, float64(digits))
        return unsafe_math_round(a * power) / power
    }

    public static function Round(a: float64, mode: MidpointRounding): float64
    {
        if mode == MidpointRounding.AwayFromZero
        {
            if a >= 0.0
            {
                return unsafe_math_floor(a + 0.5)
            }
            else
            {
                return unsafe_math_ceil(a - 0.5)
            }
        }
        return unsafe_math_round(a)
    }

    public static function Sign(value: int8): int32
    {
        if value < 0
        {
            return -1
        }
        if value > 0
        {
            return 1
        }
        return 0
    }

    public static function Sign(value: int16): int32
    {
        if value < 0
        {
            return -1
        }
        if value > 0
        {
            return 1
        }
        return 0
    }

    public static function Sign(value: int32): int32
    {
        if value < 0
        {
            return -1
        }
        if value > 0
        {
