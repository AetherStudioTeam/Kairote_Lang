    {
        if val1 > val2
        {
            return val1
        }
        return val2
    }

    public static function Max(val1: float64, val2: float64): float64
    {
        if val1 > val2
        {
            return val1
        }
        return val2
    }

    public static function Min(val1: int8, val2: int8): int8
    {
        if val1 < val2
        {
            return val1
        }
        return val2
    }

    public static function Min(val1: int16, val2: int16): int16
    {
        if val1 < val2
        {
            return val1
        }
        return val2
    }

    public static function Min(val1: int32, val2: int32): int32
    {
        if val1 < val2
        {
            return val1
        }
        return val2
    }

    public static function Min(val1: int64, val2: int64): int64
    {
        if val1 < val2
        {
