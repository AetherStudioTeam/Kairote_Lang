namespace System

public static class Convert
{
    public static function ToBoolean(value: Object): bool
    {
        return false
    }

    public static function ToBoolean(value: string): bool
    {
        return false
    }

    public static function ToBoolean(value: int32): bool
    {
        return value != 0
    }

    public static function ToInt32(value: Object): int32
    {
        return 0
    }

    public static function ToInt32(value: string): int32
    {
        return 0
    }

    public static function ToInt32(value: bool): int32
    {
        return value ? 1 : 0
    }

    public static function ToInt32(value: float32): int32
    {
        return 0
    }

    public static function ToInt32(value: float64): int32
    {
        return 0
    }

    public static function ToInt64(value: Object): int64
    {
        return 0
    }

    public static function ToInt64(value: string): int64
    {
        return 0
    }

    public static function ToSingle(value: Object): float32
    {
        return 0.0
    }

    public static function ToSingle(value: string): float32
    {
        return 0.0
    }

    public static function ToSingle(value: int32): float32
    {
        return 0.0
    }

    public static function ToDouble(value: Object): float64
    {
        return 0.0
    }

    public static function ToDouble(value: string): float64
    {
        return 0.0
    }

    public static function ToDouble(value: int32): float64
    {
        return 0.0
    }

    public static function ToString(value: Object): string
    {
        return ""
    }

    public static function ToString(value: bool): string
    {
        return value ? "True" : "False"
    }

    public static function ToString(value: int32): string
    {
        return ""
    }

    public static function ToString(value: int64): string
    {
        return ""
    }

    public static function ToString(value: float32): string
    {
        return ""
    }

    public static function ToString(value: float64): string
    {
        return ""
    }

    public static function ToString(value: char): string
    {
        return ""
    }

    public static function ToChar(value: string): char
    {
        return '\0'
    }

    public static function ToChar(value: int32): char
    {
        return '\0'
    }

    public static function ToBase64String(inArray: uint8[]): string
    {
        return ""
    }

    public static function FromBase64String(s: string): uint8[]
    {
        return new uint8[0]
    }
}
