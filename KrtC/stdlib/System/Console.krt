namespace System

public static class Console
{
    private static var inputBuffer: string = ""
    private static var inputIndex: int32 = 0

    public static function Write(value: string)
    {
        unsafe_console_write_string(value)
    }

    public static function Write(value: bool)
    {
        if value
        {
            unsafe_console_write_string("True")
        }
        else
        {
            unsafe_console_write_string("False")
        }
    }

    public static function Write(value: int32)
    {
        unsafe_console_write_int32(value)
    }

    public static function Write(value: int64)
    {
        unsafe_console_write_int64(value)
    }

    public static function Write(value: uint32)
    {
        unsafe_console_write_uint32(value)
    }

    public static function Write(value: uint64)
    {
        unsafe_console_write_uint64(value)
    }

    public static function Write(value: float32)
    {
        unsafe_console_write_float32(value)
    }

    public static function Write(value: float64)
    {
        unsafe_console_write_float64(value)
    }

    public static function Write(value: char)
    {
        unsafe_console_write_char(value)
    }

    public static function Write(value: Object)
    {
        if value == null
        {
            unsafe_console_write_string("")
        }
        else
        {
            unsafe_console_write_string(value.ToString())
        }
    }

    public static function WriteLine()
    {
        unsafe_console_write_char('\n')
    }

    public static function WriteLine(value: string)
    {
        Console.Write(value)
        Console.WriteLine()
    }

    public static function WriteLine(value: bool)
    {
        Console.Write(value)
        Console.WriteLine()
    }

    public static function WriteLine(value: int32)
    {
        Console.Write(value)
        Console.WriteLine()
    }

    public static function WriteLine(value: int64)
    {
        Console.Write(value)
        Console.WriteLine()
    }

    public static function WriteLine(value: uint32)
    {
        Console.Write(value)
        Console.WriteLine()
    }

    public static function WriteLine(value: uint64)
    {
        Console.Write(value)
        Console.WriteLine()
    }

    public static function WriteLine(value: float32)
    {
        Console.Write(value)
        Console.WriteLine()
    }

    public static function WriteLine(value: float64)
    {
        Console.Write(value)
        Console.WriteLine()
    }

    public static function WriteLine(value: char)
    {
        Console.Write(value)
        Console.WriteLine()
    }

    public static function WriteLine(value: Object)
    {
        Console.Write(value)
        Console.WriteLine()
    }

    public static function WriteLine(format: string, arg0: Object)
    {
        Console.WriteLine(String.Format(format, arg0))
    }

    public static function WriteLine(format: string, arg0: Object, arg1: Object)
    {
        Console.WriteLine(String.Format(format, arg0, arg1))
    }

    public static function WriteLine(format: string, arg0: Object, arg1: Object, arg2: Object)
    {
        Console.WriteLine(String.Format(format, arg0, arg1, arg2))
    }

    public static function Read(): int32
    {
        return unsafe_console_read_char()
    }

    public static function ReadLine(): string
    {
        return unsafe_console_read_line()
    }

    public static function ReadKey(): ConsoleKeyInfo
    {
        return Console.ReadKey(false)
    }

    public static function ReadKey(intercept: bool): ConsoleKeyInfo
    {
        var key = unsafe_console_read_key()
        var c = unsafe_console_key_to_char(key)
        var k = unsafe_console_key_to_key(key)
        var mods = unsafe_console_key_to_modifiers(key)
        return new ConsoleKeyInfo(c, k, mods)
    }

    public static function Clear()
    {
        unsafe_console_clear()
    }

    public static function SetCursorPosition(left: int32, top: int32)
    {
        if left < 0
        {
            throw new ArgumentOutOfRangeException("left")
        }
        if top < 0
        {
            throw new ArgumentOutOfRangeException("top")
        }
        unsafe_console_set_cursor_position(left, top)
    }

    public static function get_CursorLeft(): int32
    {
        return unsafe_console_get_cursor_left()
    }

    public static function set_CursorLeft(value: int32)
    {
        if value < 0
        {
            throw new ArgumentOutOfRangeException("value")
        }
        unsafe_console_set_cursor_left(value)
    }

    public static function get_CursorTop(): int32
    {
        return unsafe_console_get_cursor_top()
    }

    public static function set_CursorTop(value: int32)
    {
        if value < 0
        {
            throw new ArgumentOutOfRangeException("value")
        }
        unsafe_console_set_cursor_top(value)
    }

    public static function get_BufferWidth(): int32
    {
        return unsafe_console_get_buffer_width()
    }

    public static function set_BufferWidth(value: int32)
    {
        if value <= 0
        {
            throw new ArgumentOutOfRangeException("value")
        }
        unsafe_console_set_buffer_width(value)
    }

    public static function get_BufferHeight(): int32
    {
        return unsafe_console_get_buffer_height()
    }

    public static function set_BufferHeight(value: int32)
    {
        if value <= 0
        {
            throw new ArgumentOutOfRangeException("value")
        }
        unsafe_console_set_buffer_height(value)
    }

    public static function get_WindowWidth(): int32
    {
        return unsafe_console_get_window_width()
    }

    public static function set_WindowWidth(value: int32)
    {
        if value <= 0
        {
            throw new ArgumentOutOfRangeException("value")
        }
        unsafe_console_set_window_width(value)
    }

    public static function get_WindowHeight(): int32
    {
        return unsafe_console_get_window_height()
    }

    public static function set_WindowHeight(value: int32)
    {
        if value <= 0
        {
            throw new ArgumentOutOfRangeException("value")
        }
        unsafe_console_set_window_height(value)
    }

    public static function get_WindowLeft(): int32
    {
        return unsafe_console_get_window_left()
    }

    public static function set_WindowLeft(value: int32)
    {
        if value < 0
        {
            throw new ArgumentOutOfRangeException("value")
        }
        unsafe_console_set_window_left(value)
    }

    public static function get_WindowTop(): int32
    {
        return unsafe_console_get_window_top()
    }

    public static function set_WindowTop(value: int32)
    {
        if value < 0
        {
            throw new ArgumentOutOfRangeException("value")
        }
        unsafe_console_set_window_top(value)
    }

    public static function get_Title(): string
    {
        return unsafe_console_get_title()
    }

    public static function set_Title(value: string)
    {
        if value == null
        {
            throw new ArgumentNullException("value")
        }
        unsafe_console_set_title(value)
    }

    public static function get_BackgroundColor(): ConsoleColor
    {
        return unsafe_console_get_background_color()
    }

    public static function set_BackgroundColor(value: ConsoleColor)
    {
        unsafe_console_set_background_color(value)
    }

    public static function get_ForegroundColor(): ConsoleColor
    {
        return unsafe_console_get_foreground_color()
    }

    public static function set_ForegroundColor(value: ConsoleColor)
    {
        unsafe_console_set_foreground_color(value)
    }

    public static function ResetColor()
    {
        unsafe_console_reset_color()
    }

    public static function Beep()
    {
        unsafe_console_beep(800, 200)
    }

    public static function Beep(frequency: int32, duration: int32)
    {
        if frequency < 37 || frequency > 32767
        {
            throw new ArgumentOutOfRangeException("frequency")
        }
        if duration <= 0
        {
            throw new ArgumentOutOfRangeException("duration")
        }
        unsafe_console_beep(frequency, duration)
    }

    public static function get_In(): TextReader
    {
        return new ConsoleTextReader()
    }

    public static function get_Out(): TextWriter
    {
        return new ConsoleTextWriter()
    }

    public static function get_Error(): TextWriter
    {
        return new ConsoleErrorWriter()
    }

    public static function OpenStandardInput(): Stream
    {
        return new ConsoleStream(0)
    }

    public static function OpenStandardOutput(): Stream
    {
        return new ConsoleStream(1)
    }

    public static function OpenStandardError(): Stream
    {
        return new ConsoleStream(2)
    }

    public static function SetIn(newIn: TextReader)
    {
    }

    public static function SetOut(newOut: TextWriter)
    {
    }

    public static function SetError(newError: TextWriter)
    {
    }
}

public enum ConsoleColor
{
    Black = 0
    DarkBlue = 1
    DarkGreen = 2
    DarkCyan = 3
    DarkRed = 4
    DarkMagenta = 5
    DarkYellow = 6
    Gray = 7
    DarkGray = 8
    Blue = 9
    Green = 10
    Cyan = 11
    Red = 12
    Magenta = 13
    Yellow = 14
    White = 15
}

public struct ConsoleKeyInfo
{
    private var keyChar: char
    private var key: ConsoleKey
    private var modifiers: ConsoleModifiers

    public function ConsoleKeyInfo()
    {
        this.keyChar = '\0'
        this.key = ConsoleKey.None
        this.modifiers = ConsoleModifiers.None
    }

    public function ConsoleKeyInfo(keyChar: char, key: ConsoleKey, modifiers: ConsoleModifiers)
    {
        this.keyChar = keyChar
        this.key = key
        this.modifiers = modifiers
    }

    public function get_KeyChar(): char
    {
        return this.keyChar
    }

    public function get_Key(): ConsoleKey
    {
        return this.key
    }

    public function get_Modifiers(): ConsoleModifiers
    {
        return this.modifiers
    }
}

