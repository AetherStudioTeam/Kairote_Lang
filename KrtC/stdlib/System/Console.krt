namespace System

public static class Console
{
    public static function WriteLineString(value: string)
    {
        unsafe_console_write_string(value)
        unsafe_console_write_char('\n')
    }

    public static function WriteLineInt(value: int32)
    {
        unsafe_console_write_int32(value)
        unsafe_console_write_char('\n')
    }

    public static function WriteLineLong(value: int64)
    {
        unsafe_console_write_int64(value)
        unsafe_console_write_char('\n')
    }

    public static function WriteLineFloat(value: float32)
    {
        unsafe_console_write_float32(value)
        unsafe_console_write_char('\n')
    }

    public static function WriteLineDouble(value: float64)
    {
        unsafe_console_write_float64(value)
        unsafe_console_write_char('\n')
    }

    public static function WriteLineBool(value: bool)
    {
        if value
        {
            unsafe_console_write_string("True")
        }
        else
        {
            unsafe_console_write_string("False")
        }
        unsafe_console_write_char('\n')
    }

    public static function ReadLine(): string
    {
        return unsafe_console_read_line()
    }

    public static function ReadKey(): int32
    {
        return unsafe_console_read_char()
    }
}