{
  "project": {
    "name": "KairoteLang",
    "output": "KrtC"
  },
  "directories": {
    "source": "src",
    "objects": "obj",
    "binary": "bin",
    "include": [
      "src",
      "src/runtime/standalone",
      "shared",
      "C:/Users/18231/Desktop/KairotrLang/ArkLink/include"
    ]
  },
  "compiler": {
    "cc": "gcc",
    "alternatives": [
      "gcc",
      "clang"
    ],
    "standard": "c23",
    "debug_flags": [
      "-g",
      "-DDEBUG",
      "-Wall",
      "-Wextra",
      "-pthread"
    ],
    "release_flags": [
      "-O2",
      "-DNDEBUG",
      "-pthread"
    ],
    "extra_flags": [],
    "defines": [],
    "libraries": [
      "pthread",
      "m"
    ],
    "platform_libraries": {
      "win32": [
        "ws2_32",
        "gdi32",
        "user32"
      ],
      "linux": []
    }
  },
  "build": {
    "max_workers": 4,
    "timeout": 60,
    "incremental": true,
    "auto_detect_sources": true,
    "source_extensions": [
      ".c"
    ],
    "header_extensions": [
      ".h"
    ],
    "exclude_patterns": []
  },
  "features": {
    "colored_output": true,
    "progress_bar": true,
    "build_statistics": true,
    "dependency_tracking": true
  }
}