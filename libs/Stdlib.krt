// Standard Library - Self-contained runtime functions
// This file provides all runtime functions needed by .krt programs

// ============================================
// System.Sys - 系统调用
// ============================================
public static class Sys
{
    public const int64 SYS_read = 0;
    public const int64 SYS_write = 1;
    public const int64 SYS_open = 2;
    public const int64 SYS_close = 3;
    public const int64 SYS_mmap = 9;
    public const int64 SYS_munmap = 11;
    public const int64 SYS_brk = 12;
    public const int64 SYS_exit = 60;

    // 内建函数: 直接发出 syscall 指令
    public static extern int64 syscall(int64 number, int64 arg1, int64 arg2, int64 arg3, int64 arg4, int64 arg5, int64 arg6);

    // 内建函数: 获取字符串数据指针
    public static extern int64 InternalStringPtr(string s);

    // 内建函数: 获取字符串长度
    public static extern int64 InternalStringLength(string s);

    // 内建函数: int32 转字符串
    public static extern string InternalInt32ToString(int32 value);

    // 退出进程
    public static void Exit(int32 code)
    {
        syscall(SYS_exit, (int64)code, 0, 0, 0, 0, 0);
    }
}

// ============================================
// System.StringOps - 字符串操作
// ============================================
public static class StringOps
{
    // 字符串拼接
    public static string Concat(string a, string b)
    {
        if (a == null) a = "";
        if (b == null) b = "";

        int32 lenA = (int32)Sys.InternalStringLength(a);
        int32 lenB = (int32)Sys.InternalStringLength(b);
        int32 totalLen = lenA + lenB;

        // 使用 mmap 分配内存
        int64 buf = Sys.syscall(Sys.SYS_mmap, 0, (int64)(totalLen + 1), 3, 0x22, -1, 0);

        // 复制数据
        int64 ptrA = Sys.InternalStringPtr(a);
        int64 ptrB = Sys.InternalStringPtr(b);
        Memory.Copy((void*)buf, (void*)ptrA, lenA);
        Memory.Copy((void*)(buf + (int64)lenA), (void*)ptrB, lenB);

        // 添加 null terminator
        char[] arr = (char[])buf;
        arr[totalLen] = '\0';

        return (string)buf;
    }

    // 字符串长度
    public static int32 Length(string s)
    {
        return (int32)Sys.InternalStringLength(s);
    }
}

// ============================================
// System.Memory - 内存操作
// ============================================
public static class Memory
{
    // 分配内存
    public static void* Allocate(int64 size)
    {
        return (void*)Sys.syscall(Sys.SYS_mmap, 0, size, 3, 0x22, -1, 0);
    }

    // 释放内存
    public static void Free(void* ptr, int64 size)
    {
        Sys.syscall(Sys.SYS_munmap, (int64)ptr, size, 0, 0, 0, 0);
    }

    // 复制内存
    public static void Copy(void* dest, void* src, int32 length)
    {
        char[] d = (char[])dest;
        char[] s = (char[])src;
        int32 i = 0;
        while (i < length)
        {
            d[i] = s[i];
            i = i + 1;
        }
    }
}

// ============================================
// System.Console - 控制台输出
// ============================================
public static class Console
{
    private static int32 WriteRaw(int32 fd, int64 data, int32 length)
    {
        return (int32)Sys.syscall(1, (int64)fd, data, (int64)length, 0, 0, 0);
    }

    public static void Write(string value)
    {
        if (value == null) return;
        int64 len = Sys.InternalStringLength(value);
        int64 ptr = Sys.InternalStringPtr(value);
        WriteRaw(1, ptr, (int32)len);
    }

    public static void WriteLine(string value)
    {
        Write(value);
        WriteLine();
    }

    public static void WriteLine()
    {
        WriteRaw(1, (int64)"\n", 1);
    }

    public static void Write(int32 value)
    {
        string s = Sys.InternalInt32ToString(value);
        Write(s);
    }

    public static void WriteLine(int32 value)
    {
        Write(value);
        WriteLine();
    }
}
